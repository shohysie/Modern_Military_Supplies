//无法返回的情况，直接飞过去
IF
	OR(2)
		GlobalTimerExpired("Existime","LOCALS")
		Global("SHUTDOWN","LOCALS",1)
	InMyArea(Player1)
	TargetUnreachable(Player1)
	TargetUnreachable(Player2)
	TargetUnreachable(Player3)
	TargetUnreachable(Player4)
	TargetUnreachable(Player5)
	TargetUnreachable(Player6)
THEN
	RESPONSE #100
		ReallyForceSpellRES("MM#UAV1J",Player1)
		DisplayStringHead(Myself,@150)	//返回中……
		MakeUnselectable(6) 
END

