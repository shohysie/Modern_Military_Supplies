IF
	Die()
THEN
	RESPONSE #100
		DestroyItem("SYMRBRT")
		DestroySelf()
END

IF
	!GlobalGT("initialize","LOCALS",0)
	OR(2)
		AreaType(OUTDOOR)
		AreaType(FOREST)
THEN
	RESPONSE #100
		SetGlobal("initialize","LOCALS",1)
		SetGlobalTimer("Existime","LOCALS",600)
		ReallyForceSpellRES("SYMUAV1A",Myself)
		AddSpecialAbility("SYMUAV1J")
		SetGlobal("ACTVMODE","LOCALS",1)
		DisplayStringHead(Myself,@151)	//室外环境，可高空飞行。攻击模式默认开启
		Continue()
END

IF
	!GlobalGT("initialize","LOCALS",0)
	!AreaType(OUTDOOR)
	!AreaType(FOREST)
THEN
	RESPONSE #100
		SetGlobal("initialize","LOCALS",1)
		SetGlobalTimer("Existime","LOCALS",600)
		ReallyForceSpellRES("SYMUAV1B",Myself)
		SetGlobal("ACTVMODE","LOCALS",1)
		DisplayStringHead(Myself,@152)	//室内环境，可低空飞行，请小心障碍物。攻击模式默认开启
		Continue()
END
//拿走召唤者身上留存的召唤媒介物（也可能是没用过的，总之会删一个）
IF
	!GlobalGT("moveitem","LOCALS",0)
	Exists(LastSummonerOf())
	OR(3)
		CheckItemSlot(LastSummonerOf(),"SYMUAV1",SLOT_MISC0)
		CheckItemSlot(LastSummonerOf(),"SYMUAV1",SLOT_MISC1)
		CheckItemSlot(LastSummonerOf(),"SYMUAV1",SLOT_MISC2)
THEN
	RESPONSE #100
		SetGlobal("moveitem","LOCALS",1)
		ClearActions(LastSummonerOf())
		ActionOverride(LastSummonerOf(),GiveItem("SYMUAV1",[CONTROLLED.WEAPON.GOLEM.IMP.NO_MAGIC.BOTH.NEUTRAL]))
END
//没召唤者，按距离顺序遍历队员，拿走身上留存的召唤媒介物（也可能是没用过的，总之会删一个）
