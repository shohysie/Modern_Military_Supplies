//如果存在召唤者，则拿走召唤者身上留存的召唤媒介物（也可能是没用过的，总之会删一个）
IF
	!GlobalGT("moveitem","LOCALS",0)
	Exists(LastSummonerOf())
	OR(3)
		CheckItemSlot(LastSummonerOf(),"SYMUAV3",SLOT_MISC0)
		CheckItemSlot(LastSummonerOf(),"SYMUAV3",SLOT_MISC1)
		CheckItemSlot(LastSummonerOf(),"SYMUAV3",SLOT_MISC2)
THEN
	RESPONSE #100
		SetGlobal("moveitem","LOCALS",7)
		ClearActions(LastSummonerOf())
		ActionOverride(LastSummonerOf(),GiveItem("SYMUAV3",[CONTROLLED.WEAPON.GOLEM.BEHOLDER.NO_MAGIC.BOTH.NEUTRAL]))
END

//如果不存在召唤者，则按距离顺序遍历队员，拿走身上留存的召唤媒介物（也可能是没用过的，总之会删一个）并设置为召唤者
