@159 = "Énergie épuisée"

@160 = "Salutations, ami."
@161 = "Je teste si les appareils d'un autre monde fonctionnent ici. Ces nuisibles de grotte qui attaquent les civils font des sujets de test parfaits."
@162 = "Les règles du monde diffèrent légèrement. Certains appareils se comportent bizarrement, mais la plupart fonctionnent correctement."
@163 = "Stock limité aujourd'hui. Vous semblez dans le besoin — prenez ces échantillons gratuits. Quand vous serez prospère, trouvez-moi au deuxième étage de la Boutique du Sorcier à Porte de Baldur."

@170 = "Qu'est-ce qui vous amène ici ?"
@171 = "Résultats des tests ? Les appareils fonctionnent-ils ?"
@172 = "Je ne vous dérangerai pas plus longtemps."
@173 = "Puis-je inspecter vos articles ? Intéressé par l'achat de certains."

@180 = "Char"
@181 = "Quitter et récupérer le char"
@182 = "Activer l'imagerie thermique"
@183 = "Utiliser le système de visée"
@184 = "Modèle de char"
@185 = "Cette statue est froide et rigide, mais dégage une énergie latente comme si elle était prête à s'activer.

STATISTIQUES :

Aptitudes à charge :

- Une fois par jour, invoquez un char pour le monter (Personnel non autorisé, tenez-vous à l'écart !) pendant 5 rounds. Revertit en statue lorsque la durée se termine ou en sortant manuellement.
Poids : 2"
@187 = "Tirer un obus HEAT"
@188 = "Tirer un obus HEDP"
@189 = "Tirer un obus APFSDS"

