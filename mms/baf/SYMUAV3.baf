//优先攻击伤害操纵者的敌人
IF
	Global("ACTVMODE","LOCALS",1)
	Global("mycontroller","LOCALS",1)
	Global("attackdone","LOCALS",0)
	LOS(LastAttackerOf(Player1),30)
	WeaponEffectiveVs(LastAttackerOf(Player1),MAINHAND)
THEN
	RESPONSE #100
		SetGlobal("attackdone","LOCALS",1)
		AttackReevaluate(LastAttackerOf(Player1),5)
END

IF
	Global("ACTVMODE","LOCALS",1)
	Global("mycontroller","LOCALS",2)
	Global("attackdone","LOCALS",0)
	LOS(LastAttackerOf(Player2),30)
	WeaponEffectiveVs(LastAttackerOf(Player2),MAINHAND)
THEN
	RESPONSE #100
		SetGlobal("attackdone","LOCALS",1)
		AttackReevaluate(LastAttackerOf(Player2),5)
END

