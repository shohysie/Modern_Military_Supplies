@150 = "Retour en cours..."
@151 = "Environnement extérieur. Vol à haute altitude activé. Mode combat actif par défaut"
@152 = "Environnement intérieur. Vol à basse altitude activé. Évitez les obstacles. Mode combat actif par défaut"
@153 = "Environnement extérieur. Vol à haute altitude activé. Mode autodestruction inactif par défaut"
@154 = "Environnement intérieur. Vol à basse altitude activé. Évitez les obstacles. Mode autodestruction inactif par défaut"
@155 = "Ennemi détecté. Lancement de l'attaque"
@156 = ""
