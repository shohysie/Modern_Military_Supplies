@1 = "L'Armurerie Militaire Moderne de Shohy"
@2 = "Shohy"
@3 = ""

@6 = "Cette version ne prend pas en charge l'installation de nouvelles animations. Les chars ne seront pas présents dans le jeu."
@7 = "Aucun emplacement disponible pour de nouvelles animations. Les chars ne seront pas présents dans le jeu."

@10 = "Ravi de vous rencontrer. Intéressé par des armes et équipements d'un autre monde ?"
@11 = "Je viens d'un monde sans divinités ni magie, donc nous sommes spécialisés dans les matériaux et l'artisanat. Mes marchandises le reflètent."
@12 = ""
@13 = "Vous voulez me défier ? Alors je vais m'amuser avec vous en utilisant de vieux stocks."
@14 = "Bien joué, bien que vous ayez vaincu des reliques vieilles d'un siècle. Prenez ceci en souvenir."
@15 = "À quel type d'équipement souhaitez-vous que je consacre mon introduction ?"
@16 = "Lequel est cassé ? Que la personne qui le porte vienne me voir."
@17 = "Faible probabilité de panne, mais transportez des armes de secours au cas où. Je vais vous apprendre des compétences de maintenance de base et fournir des pièces détachées. Les dommages mineurs, vous pouvez les réparer vous-même. Pour les dommages graves, apportez-les moi. Seuls les frais de pièces seront facturés."
@18 = "Réparations terminées. Prenez-le."
@19 = "Le coût de réparation dépasse celui d'un neuf. Prenez ce remplacement gratuitement. Utilisez l'ancien comme gril ou bois de chauffage."

@20 = "Les pistolets sont des armes de poing à une main. Légers, mais la plupart manquent de pénétration et de portée contre les armures lourdes, avec des exceptions."
@21 = "Au-delà de sept pas, un pistolet est rapide. Mais en deçà de sept pas — mon ami, il n'est pas seulement rapide, il est sûr de toucher. Contrairement aux armes à distance qui deviennent inefficaces quand l'ennemi se rapproche, les pistolets excellent au combat rapproché."
@22 = ""
@23 = "Les pistolets mitrailleurs utilisent des munitions de pistolet à pénétration limitée, mais leur puissance de feu écrasante déchiquète les cibles. Dominants en combat rapproché."
@24 = "Les pistolets mitrailleurs peuvent tirer en rafales ou en automatique. Les modèles compacts sont maniables d'une main ; d'autres nécessitent deux mains. Leur taille courte favorise le combat en milieu clos."
@25 = ""
@26 = "Les balles de fusil ont une forte pénétration. Trop près, elles traversent les cibles non blindées, réduisant leur efficacité. Contre les armures lourdes, les balles qui se déforment maximisent les dégâts."
@27 = "La plupart des longs fusils sont handicapés en mêlée. Utilisez des baïonnettes en cas d'engagement. Il existe des exceptions pour les fusils plus courts."
@28 = ""
@29 = ""

@30 = "Les fusils à pompe projettent des grenaille, causant des blessures dévastatrices. Portée courte avec une pénétration plus faible que les pistolets. Idéal contre les ennemis non blindés. Peuvent aussi crocheter les serrures."
@31 = "Les fusils à pompe n'ont pas une large dispersion. Les modèles automatiques permettent le tir en rafale, mais coûtent plus cher."
@32 = ""
@33 = "Les fusils de précision sont des armes de précision avec des lunettes pour les éliminations à longue portée. Les cibles meurent sans pouvoir vous localiser."
@34 = "Cependant, le tir de précision nécessite un temps de mise en place. Impossible de tirer rapidement ou de se déplacer immédiatement après avoir fait feu."
@35 = ""
@36 = "Les mitrailleuses sont des fusils modifiés pour un tir soutenu de suppression. Elles ont tué 60 000 hommes lors de leur premier jour d'utilisation, croyez-le ou non."
@37 = "Les mitrailleuses légères permettent un tir en mouvement mais perdent en précision. Les mitrailleuses polyvalentes et lourdes nécessitent des bipieds, demandant du temps pour se déployer ou se déplacer."
@38 = "Les mitrailleuses excellent dans le tir par rafales ou soutenu, parfaites pour submerger la chair à canon ennemie."
@39 = ""

@40 = ""
@41 = "Les balles sont des projectiles métalliques propulsés par la poudre. Contrairement aux flèches qui transpercent proprement, les balles souvent tournoient/se fragmentent à l'intérieur des corps, causant des effets imprévisibles : dégâts supplémentaires, saignement, incapacité, ou inconscience."
@42 = "Types de munitions : les cartouches unitaires pour les tirs simples ; les chargeurs permettent des rafales courtes contre des cibles uniques ; les tambours permettent des rafales longues sur plusieurs cibles ; les bandes permettent un tir de suppression sur des zones plus larges."
@43 = "Différentes armes supportent des modes de tir spécifiques. Certaines uniquement en semi-automatique, d'autres en automatique. Utilisez des munitions compatibles. Les types incorrects sont inefficaces."
@44 = ""
@45 = "Les baïonnettes sont des accessoires de combat rapproché pour les armes à feu. Fixez-les manuellement pour donner des coups d'estoc comme des courtes lances. Contre les ennemis résistants, utilisez les coups de crosse. Les armes longues sont désavantagées en combat rapproché ; les armes courtes évitent ce problème."
@46 = "Ensemble de baïonnettes magiquement améliorées +2 offert avec l'achat d'un fusil maintenant. Offre limitée !"
@47 = ""
@48 = "Lancez les grenades sur les ennemis ou un terrain dégagé. Attention aux tirs fratricides. Inclut des types standards et spécialisés. Lisez attentivement les instructions."
@49 = ""

@50 = "Les mines explosent quand on marche dessus. Attention aux tirs fratricides. Certaines peuvent être lancées directement. Lisez les instructions pour plus de détails."
@51 = ""
@52 = "Mes gilets pare-balles offrent une double protection : principalement contre les balles, secondairement contre les armes de mêlée."
@53 = ""
@54 = "Les armes sans pilote permettent la reconnaissance, les attaques ou l'auto-destruction sans présence de l'opérateur. Certaines ont une IA pour le combat autonome. Traitez-les comme des golems commandables."
@55 = ""
@56 = ""
@57 = ""
@58 = ""
@59 = ""

@60 = "Les bases des armes à feu sont simples : alignez les viseurs en utilisant la méthode des trois points avec une posture stable. Une puissance de feu plus élevée signifie un recul plus fort. Tenez fermement l'arme lors du tir."
@61 = "L'expérience de l'arbalète offre peu d'avantage. Commencez l'entraînement aux armes à feu à partir de zéro. Cours d'introduction gratuits disponibles ; l'entraînement avancé nécessite un paiement."
@62 = "Les armes entièrement automatiques demandent de la prudence. Le recul soutenu perturbe la précision. Le contrôle du canon nécessite de l'expertise. Les automatiques à haute cadence et puissantes nécessitent une manipulation experte pour maximiser les impacts."
@63 = "Montrez-moi votre niveau actuel de compétence pour déterminer l'entraînement approprié."
@64 = "Aucune compétence en armes à feu détectée. Formation gratuite disponible jusqu'à l'Expertise (1 étoile)."
@65 = "Compétence en armes à feu au niveau Expertise (1 étoile). Passez au niveau Spécialiste (2 étoiles) avec 1 jour et 1000 pièces d'or."
@66 = "Compétence en armes à feu au niveau Spécialiste (2 étoiles). Passez au niveau Maître (3 étoiles) avec 2 jours et 2000 pièces d'or."
@67 = "Compétence en armes à feu au niveau Maître (3 étoiles). La progression ultérieure nécessite une expérience de combat."
@68 = "Compétence en armes à feu au niveau Grand Maître (4 étoiles). Aucune formation supplémentaire disponible. Affûtez vos compétences au combat."
@69 = "Compétence en armes à feu au niveau Suprême (5 étoiles). Entraînement inutile. Peu dans mon monde surpassent votre maîtrise."

@70 = "Compétence en armes à feu améliorée. Envoyez d'autres membres pour une formation si nécessaire."
@71 = "Chargez l'arme et vérifiez la compétence d'arbalète comme référence."
@72 = "Compétence en armes automatiques améliorée au niveau Expertise (1 étoile)"
@73 = "Compétence en armes automatiques améliorée au niveau Spécialiste (2 étoiles)"
@74 = "Compétence en armes automatiques améliorée au niveau Maître (3 étoiles)"
@75 = "Compétence en armes automatiques améliorée au niveau Grand Maître (4 étoiles)"
@76 = "Compétence en armes automatiques améliorée au niveau Suprême (5 étoiles)"

@80 = "Munitions incompatibles avec l'arme à feu"
@81 = "Dysfonctionnement mineur (ex. enrayement) détecté. Réparable immédiatement avec des compétences de base."
@82 = "Dysfonctionnement critique détecté. Nécessite un armurier professionnel. J'espère que la garantie est encore valide."
@83 = "Les produits mécaniques cassent facilement. Contactez le vendeur immédiatement. J'espère que la garantie est encore valide."

@90 = "Votre arme à feu est endommagée"
@91 = "Réparer l'arme à feu"
@92 = "Attacher la baïonnette"
@93 = "Attacher la baïonnette+2"
@94 = "Retirer la baïonnette"
@95 = "Baïonnette"
@96 = "Baïonnette+2"
@97 = "Lunette"
@98 = "Crochetage"
@99 = ""

@100 = "Montrez-moi vos marchandises."
@101 = "Parlez-moi de votre monde."
@102 = "Présentez vos armes et équipements."
@103 = "Les objets achetés précédemment nécessitent des réparations."
@104 = "Quelles précautions existent pour l'utilisation des armes à feu ?"
@105 = "Cela ressemble aux arbalètes. Si je maîtrise les arbalètes, ai-je encore besoin d'une formation aux armes à feu ?"
@106 = "Demande de formation aux armes à feu."
@107 = "Comment évaluer mon niveau de compétence ?"
@108 = "Passez à la formation immédiatement."
@109 = "Attendez que je rassemble des fonds."

@110 = "Présentez les pistolets."
@111 = "Présentez les pistolets mitrailleurs."
@112 = "Présentez les fusils."
@113 = "Présentez les fusils à pompe."
@114 = "Présentez les fusils de précision."
@115 = "Présentez les mitrailleuses."
@116 = "Présentez les munitions."
@117 = "Présentez les baïonnettes."
@118 = "Présentez les grenades."
@119 = "Présentez les mines."

@120 = "Présentez les armures."
@121 = "Présentez les armes sans pilote."
@122 = "Cet équipement risque-t-il de tomber en panne ?"
@123 = "Je vais passer mon tour pour l'instant."
@124 = "Discutons plus tard. Il est temps de partir."
@125 = "Je vous défie de démontrer vos matériaux et votre savoir-faire."

@130 = "Cécité"
@131 = "Surdité"
