	!GlobalGT("moveitem","LOCALS",0)
	!Exists(LastSummonerOf())
	OR(3)
		CheckItemSlot(LastSummonerOf(),"SYMUAV1",SLOT_MISC0)
		CheckItemSlot(LastSummonerOf(),"SYMUAV1",SLOT_MISC1)
		CheckItemSlot(LastSummonerOf(),"SYMUAV1",SLOT_MISC2)
THEN
