		CheckItemSlot([PC],"SYMUAV3",SLOT_MISC1)
		CheckItemSlot([PC],"SYMUAV3",SLOT_MISC2)
THEN
	RESPONSE #100
		SetGlobal("moveitem","LOCALS",1)
		ClearActions([PC])
		ActionOverride([PC],GiveItem("SYMUAV3",[CONTROLLED.WEAPON.GOLEM.BEHOLDER.NO_MAGIC.BOTH.NEUTRAL]))
END

