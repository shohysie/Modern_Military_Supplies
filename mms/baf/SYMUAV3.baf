//拿走后摧毁，保证只剩一个
IF
	HasItem("SYMUAV3",Myself)
THEN
	RESPONSE #100
		DestroyItem("SYMUAV3")
		Continue()
END
//拿走后产生一个坏的用来丢地上
IF
	GlobalGT("moveitem","LOCALS",0)
	GlobalLT("moveitem","LOCALS",8)
THEN
	RESPONSE #100
		CreateItem("SYMUAV3A",0,0,0)
		SetGlobal("moveitem","LOCALS",8)
		Continue()
END

//关机
IF
	GlobalLT("mycontroller","LOCALS",2)
	OR(2)
		GlobalTimerExpired("Existime","LOCALS")
		Global("SHUTDOWN","LOCALS",1)
	Range(Player1,4)
THEN
	RESPONSE #100
		GiveItemCreate("SYMUAV3",Player1,0,0,0)
		DestroySelf()
END

IF
	GlobalLT("mycontroller","LOCALS",2)
	OR(2)
		GlobalTimerExpired("Existime","LOCALS")
		Global("SHUTDOWN","LOCALS",1)
	!Range(Player1,4)
THEN
	RESPONSE #100
		DisplayStringHead(Myself,@141)	//返回中……
		MoveToObjectNoInterrupt(Player1)
END

