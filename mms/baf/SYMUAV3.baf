//计时
IF
	Global("attackdone","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobalTimer("attackonce","LOCALS",2)
		SetGlobal("attackdone","LOCALS",2)
	RESPONSE #100
		SetGlobalTimer("attackonce","LOCALS",1)
		SetGlobal("attackdone","LOCALS",2)
END

IF
	GlobalTimerExpired("attackonce","LOCALS")
THEN
	RESPONSE #100
		SetGlobal("attackdone","LOCALS",0)
END

//跟随
IF
	Global("mycontroller","LOCALS",1)
	OR(2)
		!See(NearestEnemyOf())
		Global("attackdone","LOCALS",2)
THEN
	RESPONSE #100
		FollowObjectFormation(Player1,2,2)
	RESPONSE #100
		FollowObjectFormation(Player1,-2,2)
	RESPONSE #100
		FollowObjectFormation(Player1,2,-2)
	RESPONSE #100
		FollowObjectFormation(Player1,-2,-2)
END

