		ClearActions(LastSummonerOf())
		ActionOverride(LastSummonerOf(),GiveItem("SYMUAV1",[CONTROLLED.WEAPON.GOLEM.IMP.NO_MAGIC.BOTH.NEUTRAL]))
END

