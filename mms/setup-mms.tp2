/* 
 * Shohy's Modern Military Supplies
 */

BACKUP ~mms/backup~
AUTHOR ~shohy@126.com~
VERSION ~v0.993~

AUTO_EVAL_STRINGS

README ~%MOD_FOLDER%/README.%LANGUAGE%.txt~
AUTO_TRA ~%MOD_FOLDER%/tra/%s~


LANGUAGE  ~American English~	~english~ 	~%MOD_FOLDER%/tra/english/talk.tra~
											~%MOD_FOLDER%/tra/english/guns.tra~
											~%MOD_FOLDER%/tra/english/other.tra~
LANGUAGE  ~Simplified Chinese~	~schinese~	~%MOD_FOLDER%/tra/schinese/talk.tra~
											~%MOD_FOLDER%/tra/schinese/guns.tra~
											~%MOD_FOLDER%/tra/schinese/other.tra~
LANGUAGE  ~Francais~	~french~			~%MOD_FOLDER%/tra/french/talk.tra~
											~%MOD_FOLDER%/tra/french/guns.tra~
											~%MOD_FOLDER%/tra/french/other.tra~

BEGIN @1
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet~	@2

INCLUDE ~%MOD_FOLDER%/lib/_functions.tpa~

COMPILE ~%MOD_FOLDER%/baf/SYMFAIL.baf~	//枪械损坏处理

//添加石肤的标记（镜影不用添加）
OUTER_SET "splprot_stonskins" = 0
COPY_EXISTING ~splprot.2da~ ~override~
	COUNT_2DA_ROWS 4 rows
	FOR ( index = 0 ; index < rows ; index = index + 1 ) BEGIN
		READ_2DA_ENTRY "%index%" 1 4 "splprot_stat"
		READ_2DA_ENTRY "%index%" 2 4 "splprot_value"
		READ_2DA_ENTRY "%index%" 3 4 "splprot_relation"
	  //PATCH_PRINT ~%index% %splprot_stat% %splprot_value% %splprot_relation%~
		PATCH_IF ("%splprot_stat%" STRING_COMPARE_CASE "88" = 0) & ("%splprot_value%" STRING_COMPARE_CASE "-1" = 0) & ("%splprot_relation%" STRING_COMPARE_CASE "4" = 0) BEGIN	//有现成的STONESKINS判断行
			SET "splprot_stonskins" = "%index%"
			SET "index" = "%rows%" + 1 // kills loop
		END
	END
	PATCH_IF (splprot_stonskins = 0) BEGIN
		SET "splprot_stonskins" = "%rows%"
		INSERT_2DA_ROW rows 4 ~%rows%_STONESKINS=n                           88                                            -1                                            4~
	END
BUT_ONLY	//splprot_stonskins为splprot.2da新增STONESKINS判断行的编号

/****************商人和位置*******************/

COMPILE ~%MOD_FOLDER%/dlg/SYMSTO.d~
COMPILE ~%MOD_FOLDER%/baf/SYMSTO.baf~
COMPILE ~%MOD_FOLDER%/baf/SYMTRAIN.baf~

COPY ~%MOD_FOLDER%/cre/SYMSTO.cre~ ~override~
SAY NAME1 @2
SAY NAME2 @2

ACTION_IF GAME_IS ~bgee~ THEN BEGIN
	EXTEND_TOP ~AR5400.BCS~ ~%MOD_FOLDER%/baf/AR5400.baf~	//EE在那西凯矿场
	EXTEND_TOP ~AR0704.BCS~ ~%MOD_FOLDER%/baf/AR0704.baf~	//EE在巫术杂货店
END

ACTION_IF GAME_IS ~eet~ THEN BEGIN
	EXTEND_TOP ~BG5400.BCS~ ~%MOD_FOLDER%/baf/AR5400.baf~	//EET在那西凯矿场
	EXTEND_TOP ~BG0704.BCS~ ~%MOD_FOLDER%/baf/AR0704.baf~	//EET在巫术杂货店
END

ACTION_IF FILE_EXISTS_IN_GAME ~BD0122.BCS~ THEN BEGIN
	EXTEND_TOP ~BD0122.BCS~ ~%MOD_FOLDER%/baf/AR0704.baf~	//龙矛在巫术杂货店
END

ACTION_IF GAME_IS ~eet bg2ee~ THEN BEGIN	//SOA在商旅集市，TOB在绿洲
	EXTEND_TOP ~AR2000.BCS~ ~%MOD_FOLDER%/baf/AR2000.baf~
	EXTEND_TOP ~AR6300.BCS~ ~%MOD_FOLDER%/baf/AR6300.baf~
END
COPY ~mms\sto\SYMSTO.sto~ ~override~
SAY NAME2 @2

//ee和eet出现在AR5400，808.741，12，可以送主角弹药箱包括最便宜的枪械，如果送过主角东西，则SYMSEND为1
//SYMSEND为1，RemoveStoreItem(S:Store*,S:Item*,I:Count*)移除之前送的枪械，要弄两个弹药箱一个空一个装东西送人
//

/****************枪械投射********************/

ADD_PROJECTILE      ~%MOD_FOLDER%/pro/SYMAMM0.pro~	//单发子弹/短点射，无飞行时间
ADD_PROJECTILE      ~%MOD_FOLDER%/pro/SYMAMM1.pro~	//子弹实际效果，有飞行时间
ADD_PROJECTILE      ~%MOD_FOLDER%/pro/SYMAMM2.pro~	//短筒霰弹，45度12范围（192）
ADD_PROJECTILE      ~%MOD_FOLDER%/pro/SYMAMM3.pro~	//冲锋枪长点射5hits，45度29范围（464），攻击5次
ADD_PROJECTILE      ~%MOD_FOLDER%/pro/SYMAMM4.pro~	//机枪长点射5hits，45度48范围（768），攻击5次
ADD_PROJECTILE      ~%MOD_FOLDER%/pro/SYMAMM5.pro~	//冲锋枪扫射5hits，90度29范围，攻击5次
ADD_PROJECTILE      ~%MOD_FOLDER%/pro/SYMAMM6.pro~	//机枪扫射5hits，90度48范围，攻击5次
ADD_PROJECTILE      ~%MOD_FOLDER%/pro/SYMAMM7.pro~	//枪榴弹，6呎，爆炸动画，破片
ADD_PROJECTILE      ~%MOD_FOLDER%/pro/SYMAMM8.pro~	//防护枪榴弹，7呎对敌我

ADD_PROJECTILE      ~%MOD_FOLDER%/pro/SYMMELEB.pro~	//对8呎内最近的单个敌人
ADD_PROJECTILE      ~%MOD_FOLDER%/pro/SYMMELEC.pro~	//4呎仅对友方生效
ADD_PROJECTILE      ~%MOD_FOLDER%/pro/SYMAMEX0.pro~	//视距大范围对敌，用于额外扫射
ADD_PROJECTILE      ~%MOD_FOLDER%/pro/SYMAMEX1.pro~	//2呎仅对敌，用于额外扫射
ADD_PROJECTILE      ~%MOD_FOLDER%/pro/SYMAMEX2.pro~	//8呎仅对敌，用于额外扫射
ADD_PROJECTILE      ~%MOD_FOLDER%/pro/SYMAMEX3.pro~	//16呎仅对敌，用于额外扫射


/* ********************为十字弓熟练度加标记******************** */

OUTER_SET "splprot_row" = 0
COPY_EXISTING ~splprot.2da~ ~override~
	COUNT_2DA_ROWS 4 rows
	FOR ( index = 0 ; index < rows ; index = index + 1 ) BEGIN
		READ_2DA_ENTRY "%index%" 1 4 "splprot_stat"
		READ_2DA_ENTRY "%index%" 2 4 "splprot_value"
		READ_2DA_ENTRY "%index%" 3 4 "splprot_relation"
		PATCH_IF ("%splprot_stat%" STRING_COMPARE_CASE "103" = 0) & ("%splprot_value%" STRING_COMPARE_CASE "-1" = 0) & ("%splprot_relation%" STRING_COMPARE_CASE "1" = 0) BEGIN//有现成的PROFICIENCYCROSSBOW判断行
			SET "splprot_row" = "%index%"
			SET "index" = "%rows%" + 1 // kills loop
		END
	END
	PATCH_IF (splprot_row = 0) BEGIN
		SET "splprot_row" = "%rows%"
		INSERT_2DA_ROW rows 4 ~%rows%_PROFICIENCYCROSSBOW=n                     103                                           -1                                            1~
	END
BUT_ONLY
//splprot_row为splprot.2da新增PROFICIENCYCROSSBOW判断行的编号

COPY ~%MOD_FOLDER%/bam~ ~override~
COPY ~%MOD_FOLDER%/eff~ ~override~
COPY ~%MOD_FOLDER%/cre/noname~ ~override~
COPY ~%MOD_FOLDER%/itm/noname~ ~override~
COPY ~%MOD_FOLDER%/spl/noname~ ~override~
COPY ~%MOD_FOLDER%/wav~ ~override~


/******************弹药******************/

COPY ~%MOD_FOLDER%/itm/SYMAMMA.itm~ ~override~
	SAY NAME2 @7001
	SAY IDENTIFIED_DESC @7101
COPY ~%MOD_FOLDER%/itm/SYMAMMB.itm~ ~override~
	SAY NAME2 @7002
	SAY IDENTIFIED_DESC @7102
COPY ~%MOD_FOLDER%/itm/SYMAMMC.itm~ ~override~
	SAY NAME2 @7003
	SAY IDENTIFIED_DESC @7103
COPY ~%MOD_FOLDER%/itm/SYMAMMD.itm~ ~override~
	SAY NAME2 @7004
	SAY IDENTIFIED_DESC @7104
COPY ~%MOD_FOLDER%/itm/SYMAMME.itm~ ~override~
	SAY NAME2 @7005
	SAY IDENTIFIED_DESC @7105
COPY ~%MOD_FOLDER%/itm/SYMAMMF.itm~ ~override~
	SAY NAME2 @7011
	SAY IDENTIFIED_DESC @7111
COPY ~%MOD_FOLDER%/itm/SYMAMMG.itm~ ~override~
	SAY NAME2 @7012
	SAY IDENTIFIED_DESC @7112
COPY ~%MOD_FOLDER%/itm/SYMAMMH.itm~ ~override~
	SAY NAME2 @7013
	SAY IDENTIFIED_DESC @7113
COPY ~%MOD_FOLDER%/itm/SYMAMMI.itm~ ~override~
	SAY NAME2 @7014
	SAY IDENTIFIED_DESC @7114
COPY ~%MOD_FOLDER%/itm/SYMAMMJ.itm~ ~override~
	SAY NAME2 @7015
	SAY IDENTIFIED_DESC @7115
COPY ~%MOD_FOLDER%/itm/SYMAMMK.itm~ ~override~
	SAY NAME2 @7021
	SAY IDENTIFIED_DESC @7121


/******************部分枪械近战补偿******************/

//枪上带有#232每轮自动施展SYMMELEA.spl
//SYMMELEA.spl每秒对自身施展一次SYMMELEB.spl

//SYMMELEB.spl需要写入对最近敌人的投射 SYMMELEB，对敌人施展SYMMELEC.spl
COPY ~%MOD_FOLDER%/spl/SYMMELEB.spl~ ~override~
	WRITE_SHORT   0x98 ~%SYMMELEB%~
//SYMMELEC.spl写入判断距离的对友方投射 SYMMELEC，判断施法者进行补偿
COPY ~%MOD_FOLDER%/spl/SYMMELEC.spl~ ~override~
	WRITE_SHORT   0x98 ~%SYMMELEC%~


/******************枪械表面效果基础法术******************/
//SYMAMM1-7a-d为枪械表面效果，均为对单人，含枪焰动画和不同枪械配不同火力时的枪声。没有伤害，SYMAMM1-7AB以枪械对应等级调用SYMSP1-7，SYMAMM1-7CD以枪械对应等级调用SYMAMM1-7EF
//SYMAMM1-7EF为45°和90°进行5次攻击的投射，也没有伤害，以枪械对应等级调用SYMSP1-7
//SYMSP1-7为枪械单发实际效果，首先造成伤害，再以特效概率、以枪械动能等级调用SYMSPa1-h3
//SYMSPa1-h3为枪械的各种特殊效果
//此处设置保底法术：1级头部，有投射，有开火动画和声音（声音文件留空待改，1-7a没有声音），有最低等级调用一发SYMSP1-7，b-d还有移除SYMSNDA1和2。显示文字提示的999级头部在大循环之后加
//施展法术以1%概率召唤看不见的SYMFAIL.cre处理武器熟练和损坏
//AMM1-7A法术投射为瞬间到达100%施展SP1-7，B投射瞬间到达延迟调用数次SP1-7，C和D100%调用EF范围概率施展SP1-7
//鸟由AMM1-7A法术1%召唤，其概率和枪械开火概率损坏相互独立，召唤鸟的法术在最后加上不在这里
//SYMAMM1-7a-d所有效果均为100%，因此投射用瞬间到达没有冲突
ACTION_FOR_EACH gunammtype IN 1 2 3 4 5 6 7 BEGIN
	COPY ~%MOD_FOLDER%/spl/SYMAMM1A.spl~ ~override/SYMAMM%gunammtype%A.spl~	//原始文件为播放3F的SYMMFLS1动画以及施展SYMSP1
		LPF ALTER_SPELL_HEADER INT_VAR projectile = SYMAMM0 END
		LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 146 STR_VAR resource = ~SYMSP%gunammtype%~ END

	COPY ~%MOD_FOLDER%/spl/SYMAMM1A.spl~ ~override/SYMAMM%gunammtype%B.spl~
		LPF ALTER_SPELL_HEADER INT_VAR projectile = SYMAMM0 END
		LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 146 STR_VAR resource = ~SYMSP%gunammtype%~ END
		LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 215 duration = 7 STR_VAR resource = ~SYMMFLS2~ END
		LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 9 timing = 1 insert_point = 1 STR_VAR resource = ~SYMSNDA2~ END
		LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 9 timing = 1 insert_point = 1 STR_VAR resource = ~SYMSNDA1~ END
		LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 174 target = 9 timing = 0 duration = 1 END
		LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 165 target = 9 timing = 10 duration = 7 END

	COPY ~%MOD_FOLDER%/spl/SYMAMM1A.spl~ ~override/SYMAMM%gunammtype%C.spl~
		LPF ALTER_SPELL_HEADER INT_VAR projectile = SYMAMM0 END
		LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 146 STR_VAR resource = ~SYMAMM%gunammtype%E~ END
		LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 215 duration = 14 STR_VAR resource = ~SYMMFLS2~ END
		LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 9 timing = 1 insert_point = 1 STR_VAR resource = ~SYMSNDA2~ END
		LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 9 timing = 1 insert_point = 1 STR_VAR resource = ~SYMSNDA1~ END
		LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 174 target = 9 timing = 0 duration = 1 END
		LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 165 target = 9 timing = 10 duration = 14 END
	COPY ~%MOD_FOLDER%/spl/SYMAMM1A.spl~ ~override/SYMAMM%gunammtype%D.spl~
		LPF ALTER_SPELL_HEADER INT_VAR projectile = SYMAMM0 END
		LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 146 STR_VAR resource = ~SYMAMM%gunammtype%F~ END
		LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 215 duration = 25 STR_VAR resource = ~SYMMFLS2~ END
		LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 9 timing = 1 insert_point = 1 STR_VAR resource = ~SYMSNDA2~ END
		LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 9 timing = 1 insert_point = 1 STR_VAR resource = ~SYMSNDA1~ END
		LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 174 target = 9 timing = 0 duration = 1 END
		LPF ADD_SPELL_EFFECT INT_VAR header = 1 opcode = 165 target = 9 timing = 10 duration = 25 END

	COPY ~%MOD_FOLDER%/spl/SYMAMM1A.spl~ ~override/SYMAMM%gunammtype%E.spl~
		LPF ALTER_SPELL_HEADER INT_VAR projectile = SYMAMM3 END
		LPF DELETE_SPELL_EFFECT INT_VAR match_opcode = 215 END
		LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 146 STR_VAR resource = ~SYMSP%gunammtype%~ END

	COPY ~%MOD_FOLDER%/spl/SYMAMM1A.spl~ ~override/SYMAMM%gunammtype%F.spl~
		LPF ALTER_SPELL_HEADER INT_VAR projectile = SYMAMM5 END
		LPF DELETE_SPELL_EFFECT INT_VAR match_opcode = 215 END
		LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 146 STR_VAR resource = ~SYMSP%gunammtype%~ END
		
	COPY ~%MOD_FOLDER%/spl/SYMSP%gunammtype%.spl~ ~override~
		WRITE_SHORT   0x98 ~%SYMAMM1%~
END

/******************子弹打出特效时，具体特效概率设置********************/
COPY ~%MOD_FOLDER%/spl/SYMSPA1.spl~ ~override~
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 0 probability1 = 49 probability2 = 25 END		//25%降防
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 39 probability1 = 69 probability2 = 30 END	//40%昏迷
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 54 probability1 = 84 probability2 = 60 END	//25%降攻
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 73 probability1 = 84 probability2 = 60 END	//25%降攻
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 126 probability1 = 74 probability2 = 50 END	//25%减速
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 45 probability1 = 29 probability2 = 0 END		//30%震慑
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 165 probability1 = 29 probability2 = 0 END	//30%震慑
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 235 probability1 = 59 probability2 = 30 END	//30%击退
//A1和B1的基础文件只有流血概率不同。A1为75-99即25%流血，B1为55-99即45%流血
COPY ~%MOD_FOLDER%/spl/SYMSPB1.spl~ ~override~
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 0 probability1 = 49 probability2 = 20 END		//30%降防
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 39 probability1 = 69 probability2 = 40 END	//30%昏迷
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 54 probability1 = 99 probability2 = 70 END	//30%降攻
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 73 probability1 = 99 probability2 = 70 END	//30%降攻
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 126 probability1 = 79 probability2 = 50 END	//30%减速
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 45 probability1 = 19 probability2 = 0 END		//20%震慑
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 165 probability1 = 19 probability2 = 0 END	//20%震慑
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 235 probability1 = 64 probability2 = 5 END	//60%击退
//主要模拟打中头部
ACTION_FOR_EACH sptype IN A1 A2 A3 F1 BEGIN
	COPY_EXISTING ~SYMSPA1.spl~ ~override/SYMSP%sptype%.spl~
		LPF ALTER_SPELL_HEADER INT_VAR projectile = SYMAMM1 END
		LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 318 STR_VAR resource = ~SYMSP%sptype%~ END
		LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 39 STR_VAR parameter2 = 1 END
		LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 324 new_opcode = 318 parameter1 = 1 parameter2 = ~%splprot_stonskins%~ END	//石肤免疫特效
		LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 parameter1 = 0x40000000 parameter2 = 138 insert_point = 0 STR_VAR resource = ~SYMSP%sptype%~ END	//镜影免疫特效
END
//主要模拟打中躯干
ACTION_FOR_EACH sptype IN B1 B2 C1 C2 C3 D1 E2 E3 G1 H2 BEGIN
	COPY_EXISTING ~SYMSPB1.spl~ ~override/SYMSP%sptype%.spl~
		LPF ALTER_SPELL_HEADER INT_VAR projectile = SYMAMM1 END
		LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 318 STR_VAR resource = ~SYMSP%sptype%~ END
		LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 39 STR_VAR parameter2 = 1 END
		LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 324 new_opcode = 318 parameter1 = 1 parameter2 = ~%splprot_stonskins%~ END	//石肤免疫特效
		LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 parameter1 = 0x40000000 parameter2 = 138 insert_point = 0 STR_VAR resource = ~SYMSP%sptype%~ END	//镜影免疫特效
END

/******************狙击榴专用的SYMAMM8B近战不会炸********************/
//SYMAMM8b为97号狙击榴特殊处理，不用读表格直接写数值，不暂停，得有枪焰和枪声，该枪并没有单发枪声所以不需要移除
//对自己施展im8对敌人施展sp8
	
COPY ~%MOD_FOLDER%/spl/SYMAMM8B.spl~ ~override~
	WRITE_SHORT   0x98 ~%SYMAMM0%~
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 target = 9 parameter1 = 5 parameter2 = 134 probability1 = 0 STR_VAR resource = ~SYMFAIL~ END
	LPF ADD_SPELL_EFFECT INT_VAR opcode = 146 target = 9 timing = 1 parameter2 = 1 probability1 = 0 STR_VAR resource = ~SYMFAIL~ END
	LPF ADD_SPELL_HEADER INT_VAR type = 2 location = 0 range = 250 required_level = 999 projectile = SYMAMM0 RET insert_point END
	LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 139 target = 9 timing = 1 parameter1 = RESOLVE_STR_REF(@80) END

COPY ~%MOD_FOLDER%/spl/SYMSP8.spl~ ~override~
	WRITE_SHORT   0x98 ~%SYMAMM1%~
	
//SYMSP8是单体，调用的sp81才是爆炸。如果SYMSP8是爆炸则无法被SYMIM8阻挡
COPY ~%MOD_FOLDER%/spl/SYMSP81.spl~ ~override~
	WRITE_SHORT   0x98 ~%SYMAMM7%~

//SYMIM8为11呎防护sp8
COPY ~%MOD_FOLDER%/spl/SYMIM8.spl~ ~override~
	WRITE_SHORT   0x98 ~%SYMAMM8%~
//【SYMAMM8A似乎一直生效提示枪弹不匹配但是都有正常伤害】

COPY ~%MOD_FOLDER%/spl/SYMAMM8A.spl~ ~override~	//显示枪弹不匹配提示
	WRITE_SHORT   0x98 ~%SYMAMM1%~
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 139 parameter1 = RESOLVE_STR_REF(@80) END

COPY  ~%MOD_FOLDER%/spl/SYMAMMI.spl~ ~override~	//显示枪弹不匹配提示
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 139 parameter1 = RESOLVE_STR_REF(@80) END

/******************达姆弹专用的SYMAMM9e********************/
//枪以gunid或gunsinglehit施展SYMAMM1-8a-d，但要以gunkinetic施展SYMAMM9e
//对比SYMAMM1-8a-d决定范围投射和枪声并调用sp1-8再以特效概率和动能等级调用SYMSPa1-h3，SYMAMM9e不需要枪声，且100%打出特效，因此不需要SYMSP9而是以动能等级直接调用spa1/b1/d1
//SYMAMM9e有单体投射，有开火动画，无声音，以动能等级决定直接伤害和调用spa1/b1/d1
//gunsinglehit为0以及90>gunid>80的霰弹枪系列不允许使用达姆弹

COPY ~%MOD_FOLDER%/spl/SYMAMM9E.spl~ ~override~
	LPF ALTER_SPELL_HEADER INT_VAR projectile = SYMAMM0 END
	LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 139 parameter1 = RESOLVE_STR_REF(@80) END
	

/*******************枪械熟练带来额外扫射的预处理******************** */

////如果在攻击时根据自己熟练度施法锥形范围给敌人加标记，那么这个标记要比#146参数2的枪械效果靠后，因此枪械效果没法追加，排除。只能制作不使用#146参数2的效果进行追加
///在弹药上给敌人加标记，比枪更先。在枪击效果中使用#146参数1调用新法术测试，仍然是新法术比标记更早生效，排除
///在弹药上需要施展范围法术给敌人加标记，必须比枪更先，但因为没法用#146参数2，只有次而选择瞬达的投射
//在弹药上以#326检查开枪者的十字弓熟练度再施展SYMAMEX1/2/3.spl（34星）和4/5/6.spl（5星）法术范围分别为以敌人为中心的小中大圆形，给敌人加标记
COPY_EXISTING ~SYMAMMB.itm~ ~override~ ~SYMAMMC.itm~ ~override~ ~SYMAMMD.itm~ ~override~ ~SYMAMMG.itm~ ~override~ ~SYMAMMH.itm~ ~override~ ~SYMAMMI.itm~ ~override~
	//PATCH_PRINT ~splprot_row=%splprot_row%~
	LPF ALTER_ITEM_EFFECT INT_VAR check_headers = 1 header_type = 2 match_opcode = 326 parameter2 = splprot_row END
//熟练度满足要求即施展下列范围法术
COPY ~%MOD_FOLDER%/spl/SYMAMEX1.spl~ ~override/SYMAMEX1.spl~ ~%MOD_FOLDER%/spl/SYMAMEX4.spl~ ~override/SYMAMEX4.spl~
	WRITE_SHORT   0x98 ~%SYMAMEX1%~	//弹药SYMAMMB/G/L.itm施展，熟练度34用EX1，5用EX4，给2呎范围内敌人做不同标记
COPY ~%MOD_FOLDER%/spl/SYMAMEX1.spl~ ~override/SYMAMEX2.spl~ ~%MOD_FOLDER%/spl/SYMAMEX4.spl~ ~override/SYMAMEX5.spl~
	WRITE_SHORT   0x98 ~%SYMAMEX2%~	//弹药SYMAMMC/H.itm施展，熟练度34用EX2，5用EX5，给8呎范围内敌人做不同标记
COPY ~%MOD_FOLDER%/spl/SYMAMEX1.spl~ ~override/SYMAMEX3.spl~ ~%MOD_FOLDER%/spl/SYMAMEX4.spl~ ~override/SYMAMEX6.spl~
	WRITE_SHORT   0x98 ~%SYMAMEX3%~	//弹药SYMAMMD/I.itm施展，熟练度34用EX3，5用EX6，给16呎范围内敌人做不同标记
//上述法术标记splstate里26 ENTANGLE/27 WEB + 29 FREEACTION，正常不可能存在
//然后枪械攻击时根据枪械类型另外对自身施展90°的法术SYMAMB%gunburstplus%，即SYMAMB1-7a-d，这里的a-d不是点射扫射，是额外打中子弹数量等级（gunburstplushits为具体数量）
//SYMAMB%gunburstplus%检查正常不可能有的标记（26 ENTANGLE/27 WEB + 29 FREEACTION）调用SP1-7给出额外攻击

//子弹施展SYMAMEX1-6加标记，枪械以#146模式1调用SYMAMB1-7a-d，SYMAMB1-7a-d（投射SYMAMEX0）以模式2指定等级调用SP1-7
//3处参数可调：SYMAMEX1-6投射SYMAMEX123是否瞬达和法术持续帧，枪械#146模式2，投射SYMAMEX0是否瞬达

//SYMAMEX1-6投射SYMAMEX2瞬达持续帧0，枪械#146模式1，投射SYMAMEX0非瞬达：SYMAMEX0以自身为圆心画圆或往背后画锥，扫射不生效
//SYMAMEX1-6投射SYMAMEX2瞬达持续帧1，枪械#146模式1，投射SYMAMEX0非瞬达：SYMAMEX0以自身为圆心画圆或往背后画锥，扫射偶尔生效
//SYMAMEX1-6投射SYMAMEX2瞬达持续帧2，枪械#146模式1，投射SYMAMEX0非瞬达：SYMAMEX0以自身为圆心画圆或往背后画锥，扫射完全生效	**选这一种设置
//SYMAMEX1-6投射SYMAMEX2瞬达持续帧0，枪械#146模式1，投射SYMAMEX0瞬达：SYMAMEX0以自身为圆心画圆或往背后画锥，扫射仅当人物在上方时生效  *旧设置

//SYMAMEX1-6投射SYMAMEX2瞬达持续帧0，枪械#146模式2，投射SYMAMEX0瞬达：SYMAMEX0以敌人为圆心画圆或往背后画锥，扫射不生效
//SYMAMEX1-6投射SYMAMEX2瞬达持续帧1，枪械#146模式2，投射SYMAMEX0瞬达：SYMAMEX0以敌人为圆心画圆或往背后画锥，扫射一半生效
//SYMAMEX1-6投射SYMAMEX2瞬达持续帧2，枪械#146模式2，投射SYMAMEX0瞬达：SYMAMEX0以敌人为圆心画圆或往背后画锥，扫射大半生效
//SYMAMEX1-6投射SYMAMEX2瞬达持续帧3，枪械#146模式2，投射SYMAMEX0瞬达：SYMAMEX0以敌人为圆心画圆或往背后画锥，扫射几乎完全生效

//SYMAMEX1-6投射SYMAMEX2非瞬达持续帧0，枪械#146模式2，投射SYMAMEX0非瞬达：SYMAMEX0以敌人为圆心画圆或往背后画锥，扫射不生效
//SYMAMEX1-6投射SYMAMEX2非瞬达持续帧1，枪械#146模式2，投射SYMAMEX0非瞬达：SYMAMEX0以敌人为圆心画圆或往背后画锥，扫射偶尔生效
//SYMAMEX1-6投射SYMAMEX2非瞬达持续帧2，枪械#146模式2，投射SYMAMEX0非瞬达：SYMAMEX0以敌人为圆心画圆或往背后画锥，扫射大半生效
//SYMAMEX1-6投射SYMAMEX2非瞬达持续帧3，枪械#146模式2，投射SYMAMEX0非瞬达：SYMAMEX0以敌人为圆心画圆或往背后画锥，扫射几乎完全生效

/*******************枪械批处理******************** */

COPY ~%MOD_FOLDER%/2da/SYMDTLS.2DA~ ~override~
	COUNT_2DA_ROWS 30 gunmax		//至少30列column，row行数读入gunmax
	FOR (gunnum = 1 ; gunnum < gunmax ; ++gunnum) BEGIN
		READ_2DA_ENTRY gunnum 0 30 guncode	//枪械代码
		READ_2DA_ENTRY gunnum 1 30 gundesc	//说明文本条目
		READ_2DA_ENTRY gunnum 2 30 gunhands	//单双手
		READ_2DA_ENTRY gunnum 3 30 gunprice	//价格
		READ_2DA_ENTRY gunnum 4 30 gunweight	//重量
		READ_2DA_ENTRY gunnum 5 30 gunstr	//力量需求
		READ_2DA_ENTRY gunnum 6 30 gunapr	//每轮攻击次数
		READ_2DA_ENTRY gunnum 7 30 guntohit	//命中
		READ_2DA_ENTRY gunnum 8 30 gunspeed	//出手速度
		READ_2DA_ENTRY gunnum 9 30 gunrange	//射程
		READ_2DA_ENTRY gunnum 10 30 gunpod	//脚架
		READ_2DA_ENTRY gunnum 11 30 gunbayonet	//刺刀
		READ_2DA_ENTRY gunnum 12 30 gunscope	//瞄具
		READ_2DA_ENTRY gunnum 13 30 gunopenlock	//开锁
		READ_2DA_ENTRY gunnum 14 30 gunmelee	//近战补偿
		READ_2DA_ENTRY gunnum 15 30 gunfail	//轻微损坏概率
		READ_2DA_ENTRY gunnum 16 30 gunruin	//严重损坏概率
		READ_2DA_ENTRY gunnum 17 30 gunid	//枪械id也是SYMAMM1-7a-d的施法等级
		READ_2DA_ENTRY gunnum 18 30 gunammtype	//弹种SYMAMM1-7
		READ_2DA_ENTRY gunnum 19 30 gunsinglehit	//单发效果编号，由于gunid超过40，共用单发效果相同的编号，为0表示不单发
		READ_2DA_ENTRY gunnum 20 30 gunbursthits	//短点射初始等级，打中几发
		READ_2DA_ENTRY gunnum 21 30 gunstrafetohit	//长点射和扫射每次攻击命中率（五次攻击）
		READ_2DA_ENTRY gunnum 22 30 gunshortframe	//短点射持续帧（正常5，有些枪特别慢）
		READ_2DA_ENTRY gunnum 23 30 gunlongframe	//长点射持续帧（正常10，有些枪特别慢）
		READ_2DA_ENTRY gunnum 24 30 gunstrafeframe	//扫射持续帧（正常22，有些枪特别慢）
		READ_2DA_ENTRY gunnum 25 30 gundicethrown	//伤害骰数
		READ_2DA_ENTRY gunnum 26 30 gundicesides	//伤害骰面
		READ_2DA_ENTRY gunnum 27 30 gundiceplus	//伤害掷骰外加
		READ_2DA_ENTRY gunnum 28 30 gunkinetic	//动能等级
		READ_2DA_ENTRY gunnum 29 30 gunprobability	//特效概率
		READ_2DA_ENTRY gunnum 30 30 gunburstplus	//额外扫射法术
		READ_2DA_ENTRY gunnum 31 30 gunburstplushits	//额外扫射打几发
		READ_2DA_ENTRY gunnum 32 30 gunhugeexhits	//对大体型点射额外打几发
		READ_2DA_ENTRY gunnum 33 30 gunhugeextohit	//对大体型扫射额外命中
		
		gundesc1 = gundesc + 100	//枪械数据说明，需按表格修正
		gundesc2 = gundesc + 200
		gundesc3 = gundesc + 300
		gundesc4 = gundesc + 400
		gundesc5 = gundesc + 500
		gundesc6 = gundesc + 500
		gundesc7 = gundesc + 500
		
		INNER_ACTION BEGIN

			COPY ~%MOD_FOLDER%/itm/SYMAST1.itm~ ~override/SYM%guncode%.itm~	//样本物品必须全员可用，自带#232条件20特殊102对自身施法SYMPRF0-4，有武器攻击头部无法术
				//武器的熟练度：武器每轮施法SYMPRF0-5分别将该项原有专长熟练度设为0~5星，且低星免疫高星。每个低星法术失效都会实现高一级的熟练度
				//对话和脚本施法SYMPRF0-4I.spl，效果为永久免疫SYMPRF0-4.spl，且将人物局部变量SYMPRF设为1~5作为记录。这样人物会根据身上SYMPRF0-4I将专长修正到适当的数值。

				PATCH_IF gunammtype == 1 BEGIN SET prob1 = 40 * gunprobability / 100 SET prob2 = 40 * gunprobability / 100 SET prob3 = 15 * gunprobability / 100 END
				PATCH_IF gunammtype == 2 BEGIN SET prob1 = 75 * gunprobability / 100 SET prob2 = 50 * gunprobability / 100 SET prob3 = 10 * gunprobability / 100 END
				PATCH_IF gunammtype == 3 BEGIN SET prob1 = 35 * gunprobability / 100 SET prob2 = 70 * gunprobability / 100 SET prob3 = 25 * gunprobability / 100 END
				PATCH_IF gunammtype == 4 BEGIN SET prob1 = 50 * gunprobability / 100 SET prob2 = 50 * gunprobability / 100 SET prob3 = 30 * gunprobability / 100 END
				PATCH_IF gunammtype == 5 BEGIN SET prob1 = 25 * gunprobability / 100 SET prob2 = 50 * gunprobability / 100 SET prob3 = 50 * gunprobability / 100 END
				PATCH_IF gunammtype == 6 BEGIN SET prob1 = 45 * gunprobability / 100 SET prob2 = 65 * gunprobability / 100 SET prob3 = 80 * gunprobability / 100 END
				PATCH_IF gunammtype == 7 BEGIN SET prob1 = 60 * gunprobability / 100 SET prob2 = 70 * gunprobability / 100 SET prob3 = 90 * gunprobability / 100 END

				SPRINT ammotype1 @7001	//"子弹"
				SPRINT ammotype2 @7002	//"弹匣"
				SPRINT ammotype3 @7003	//"弹鼓"
				SPRINT ammotype4 @7004	//"弹带"
				SPRINT matchammo @200	//"^[ %TAB%]*填充弹药：.+$"
				SPRINT writeammo @201	//"填充弹药："
				SPRINT matchpercent @202	//"[0-9]+|[0-9]+|[0-9]+|[0-9]+%"
				SPRINT writepercent @203	//"%prob1%%/%prob1%%/%prob2%%/%prob3%%"
				SPRINT matchdamage @204	//"^[ %TAB%]*伤害力：.+$"
				SPRINT writedamage @205	//"伤害力： "
				SPRINT directhit @206	//"（直击）"
				SPRINT matchtohit @207	//"^[ %TAB%]*零级命中值：.+$"
				SPRINT writetohit @208	//"零级命中值：+"
				SPRINT matchapr @209	//"^[ %TAB%]*每轮攻击次数：.+$"
				SPRINT writeapr @210	//"每轮攻击次数："
				SPRINT matchrange @211	//"^[ %TAB%]*射程：.+$"
				SPRINT writerange @212	//"射程："
				SPRINT matchweight @213	//"^[ %TAB%]*重量：.+$"
				SPRINT writeweight @214	//"重量："
				SPRINT matchspeed @215	//"^[ %TAB%]*武器速度：.+$"
				SPRINT writespeed @216	//"武器速度："
				SPRINT matchhanded @217	//"^[ %TAB%]*种类：[ %TAB%]*[单双]手持用"
				SPRINT write1handed @218	//"种类：单手持用"
				SPRINT write2handed @219	//"种类：双手持用"
				SPRINT matchstr @220	//"^[ %TAB%]*需求：[ %TAB%]*力量[0-9].+$"
				SPRINT writestr @221	//"需求：力量"
				SPRINT writestr1 @222	//空，英文版有用

				PATCH_IF gunsinglehit > 0 BEGIN
					SPRINT writeammo ~%writeammo%~^~%ammotype1%~
					PATCH_IF gunshortframe > 0 BEGIN
						SPRINT writeammo ~%writeammo%~^~/%ammotype2%~
						PATCH_IF gunlongframe > 0 BEGIN
							SPRINT writeammo ~%writeammo%~^~/%ammotype3%~
							PATCH_IF gunstrafeframe > 0 BEGIN
								SPRINT writeammo ~%writeammo%~^~/%ammotype4%~
							END
						END
					END
				END ELSE BEGIN
					PATCH_IF gunshortframe > 0 BEGIN
						SPRINT writeammo ~%writeammo%~^~%ammotype2%~
						PATCH_IF gunlongframe > 0 BEGIN
							SPRINT writeammo ~%writeammo%~^~/%ammotype3%~
							PATCH_IF gunstrafeframe > 0 BEGIN
								SPRINT writeammo ~%writeammo%~^~/%ammotype4%~
							END
						END
					END
				END

				SPRINT writedamage ~%writedamage%~^~%gundicethrown%~
				SPRINT writedamage ~%writedamage%~^~D%gundicesides%~
				PATCH_IF gundiceplus > 0 BEGIN
					SPRINT writedamage ~%writedamage%~^~+%gundiceplus%~
				END
				PATCH_IF gunid == 97 BEGIN
					SPRINT writeammo ~%writeammo%~^~%ammotype2%~
					SPRINT writedamage ~%writedamage%~^~%directhit%~
				END
				
				SPRINT writetohit ~%writetohit%~^~%guntohit%~
				SPRINT writerange ~%writerange%~^~%gunrange%~
				SPRINT writeweight ~%writeweight%~^~%gunweight%~
				SPRINT writespeed ~%writespeed%~^~%gunspeed%~
				SPRINT writestr ~%writestr%~^~%gunstr%~
				SPRINT writestr ~%writestr%~^~%writestr1%~
				
				PATCH_IF gunapr > 5 BEGIN
					SET tempapr = gunapr - 6
					SPRINT writeapr ~%writeapr%~^~%tempapr%.5~
				END ELSE BEGIN
					SPRINT writeapr ~%writeapr%~^~%gunapr%~
				END
								
				PATCH_IF gunhands == 1 BEGIN
					SPRINT writehanded ~%write1handed%~
				END ELSE BEGIN
					SPRINT writehanded ~%write2handed%~
				END
				
				SPRINT detailedgundesc ( AT "%gundesc1%" )
				INNER_PATCH_SAVE detailedgundesc ~%detailedgundesc%~ BEGIN
					REPLACE_TEXTUALLY ~%matchammo%~ ~%writeammo%~
					REPLACE_TEXTUALLY ~%matchpercent%~ ~%writepercent%~
					REPLACE_TEXTUALLY ~%matchdamage%~ ~%writedamage%~
					REPLACE_TEXTUALLY ~%matchtohit%~ ~%writetohit%~
					REPLACE_TEXTUALLY ~%matchapr%~ ~%writeapr%~
					REPLACE_TEXTUALLY ~%matchrange%~ ~%writerange%~
					REPLACE_TEXTUALLY ~%matchweight%~ ~%writeweight%~
					REPLACE_TEXTUALLY ~%matchspeed%~ ~%writespeed%~
					REPLACE_TEXTUALLY ~%matchhanded%~ ~%writehanded%~
					REPLACE_TEXTUALLY ~%matchstr%~ ~%writestr%~
				END
				
				SAY NAME2 ( AT "%gundesc%" )
				SAY IDENTIFIED_DESC ~%detailedgundesc%~
				PATCH_IF ( gunhands == 2 ) BEGIN WRITE_SHORT 0x18 0x2E END ELSE BEGIN WRITE_SHORT 0x18 0x2C END
				WRITE_SHORT 0x26 gunstr
				WRITE_SHORT 0x34 gunprice
				WRITE_EVALUATED_ASCII 0x3a ~ISYM%guncode%~
				WRITE_SHORT 0x4c gunweight
				WRITE_EVALUATED_ASCII 0x58 ~CSYM%guncode%~
				PATCH_IF ( gunfail > 0 ) BEGIN	//损坏物品
					WRITE_EVALUATED_ASCII 0x10 ~SYM%guncode%A~
				END ELSE BEGIN
					WRITE_EVALUATED_ASCII 0x10 ~SYM%guncode%~
				END
				LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 1 target = 1 parameter1 = gunapr parameter2 = 1 timing = 2 END	//攻击频率
				
				PATCH_IF gunkinetic < 6 BEGIN
					LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 341 target = 1 parameter2 = 1 timing = 2 STR_VAR resource = ~SYMCRTI1~ END	//致命一击
				END				
				PATCH_IF (gunkinetic > 5)&&(gunkinetic < 11) BEGIN
					LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 341 target = 1 parameter2 = 1 timing = 2 STR_VAR resource = ~SYMCRTI2~ END	//致命一击
				END				
				PATCH_IF (gunkinetic > 10)&&(gunkinetic < 16) BEGIN
					LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 341 target = 1 parameter2 = 1 timing = 2 STR_VAR resource = ~SYMCRTI3~ END	//致命一击
				END				
				PATCH_IF gunkinetic > 15 BEGIN
					LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 341 target = 1 parameter2 = 1 timing = 2 STR_VAR resource = ~SYMCRTI4~ END	//致命一击
				END
				
				PATCH_IF ( gunid == 27 ) BEGIN
					LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 6 target = 1 parameter1 = 1 timing = 2 END	//沙鹰+1魅力
				END
				PATCH_IF ( gunid == 43 ) BEGIN
					LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 6 target = 1 parameter1 = ~-1~ timing = 2 END	//水管-1魅力
				END
				LPF ALTER_ITEM_HEADER INT_VAR header = 1 range = gunrange speed = gunspeed thac0_bonus = guntohit STR_VAR icon = ~ISYM%guncode%~ END	//出手速度，命中，射程，图标

				PATCH_IF gunid == 97 BEGIN	//狙击榴近距离不让炸
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 146 type = 4 target = 1 timing = 1 parameter2 = 1 STR_VAR resource = ~SYMIM8~ END
				END

				//让目标免疫所有弹药类型的效果，参数2必须是2！
				LPF ADD_ITEM_EFFECT INT_VAR opcode = 146 type = 4 target = 2 parameter1 = 1 parameter2 = 2 STR_VAR resource = ~SYMAMMI~ END
				
				//所有可单发枪械开枪时以gunid等级施法SYMSNDA1和2，内容为延迟1帧对自己播放单发枪声（不含伤害和枪焰），法术等级有数量上限只能分两个法术
				//后继如果连发成功施展则（amm1-7b-d）移除法术效果再播放正常枪声，如果弹药不对也移除法术效果（999级的amm1-9a-e）
				PATCH_IF gunid < 50 BEGIN
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 146 type = 4 target = 1 parameter1 = gunid parameter2 = 2 STR_VAR resource = ~SYMSNDA1~ END
				END ELSE BEGIN
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 146 type = 4 target = 1 parameter1 = gunid parameter2 = 2 STR_VAR resource = ~SYMSNDA2~ END
				END
				
				//根据gunid等级施法本枪械在此口径所有弹药类型上的效果//例AST1，编号71口径5，以gunid即等级71施展SYMAMM5a-e
				//每种枪械对a-e弹药都有对应法术，但弹药和枪械口径1-7不符时以999级施法，内容为显示弹药错误
				//例无扫射的口径2枪械: SYMAMMI(免疫所有)+SYMAMM2a-c(正常等级)+2d(999级)+9e(动能等级)
				PATCH_IF ( gunammtype != 8 ) BEGIN
					//有单发则以gunsinglehit等级施展SYMAMM%gunammtype%A，没有就是999级施展
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 146 type = 4 target = 2 parameter1 = (gunsinglehit > 0) ? gunsinglehit : 999 parameter2 = 2 STR_VAR resource = ~SYMAMM%gunammtype%A~ END
					//有短点射则以gunid等级施展SYMAMM%gunammtype%B，没有就是999级施展
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 146 type = 4 target = 2 parameter1 = (gunbursthits > 0) ? gunid : 999 parameter2 = 2 STR_VAR resource = ~SYMAMM%gunammtype%B~ END
					//有长点射则以gunid等级施展SYMAMM%gunammtype%C，没有就是999级施展
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 146 type = 4 target = 2 parameter1 = (gunlongframe > 0) ? gunid : 999 parameter2 = 2 STR_VAR resource = ~SYMAMM%gunammtype%C~ END
					//有扫射则以gunid等级施展SYMAMM%gunammtype%D，没有就是999级施展
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 146 type = 4 target = 2 parameter1 = (gunstrafeframe > 0) ? gunid : 999 parameter2 = 2 STR_VAR resource = ~SYMAMM%gunammtype%D~ END
					//可以单发且不是霰弹枪则以gunkinetic等级施展SYMAMM%gunammtype%E，没有就是999级施展
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 146 type = 4 target = 2 parameter1 = (gunsinglehit > 0 && (NOT (gunid > 80 && gunid < 90))) ? gunkinetic : 999 parameter2 = 2 STR_VAR resource = ~SYMAMM9E~ END
				END ELSE BEGIN	//口径8枪械: SYMAMMI(免疫所有)+SYMAMM8a(999级)+8b(1级)
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 146 type = 4 target = 2 parameter1 = 999 parameter2 = 2 STR_VAR resource = ~SYMAMM%gunammtype%A~ END
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 146 type = 4 target = 2 parameter1 = 1 parameter2 = 2 STR_VAR resource = ~SYMAMM%gunammtype%B~ END
				END

				PATCH_IF ( gunpod > 0 ) BEGIN	//脚架，开枪后要收拾，一定时间无法移动
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 126 type = 4 target = 1 parameter1 = 0 parameter2 = 1 timing = 0 duration = ( gunpod * 3 - 3 ) END
				END

//额外扫射用，枪械攻击时施展90°的法术，不能用以指定等级施法，只能做成多个不同法术SYMAMB%gunburstplus%.spl
				//之后法术需要检查标记给出额外攻击
				PATCH_IF ( gunburstplushits != 0 ) BEGIN
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 146 type = 4 target = 1 timing = 1 parameter2 = 1 STR_VAR resource = ~SYMAMB%gunburstplus%~ END
				END
				
				//施法以损坏概率修改自身的变量。另外在sp1-7里以1%召唤生物用脚本判断人物是否带此变量来处理武器损坏，顺便处理武器熟练度
				PATCH_IF ( gunfail > 0 ) BEGIN
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 309 type = 4 probability1 = (gunfail - 1) target = 1 parameter1 = 1 timing = 1 STR_VAR resource = ~SYMFAIL~ END
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 309 type = 4 probability1 = (gunfail - 1) target = 1 parameter1 = 0 timing = 4 duration = 6 STR_VAR resource = ~SYMFAIL~ END
				END
				PATCH_IF ( gunruin > 0 ) BEGIN
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 309 type = 4 probability2 = (100 - gunruin) target = 1 parameter1 = 2 timing = 1 STR_VAR resource = ~SYMFAIL~ END
					LPF ADD_ITEM_EFFECT INT_VAR opcode = 309 type = 4 probability2 = (100 - gunruin) target = 1 parameter1 = 0 timing = 4 duration = 6 STR_VAR resource = ~SYMFAIL~ END
				END
				
				PATCH_IF ( gunbayonet > 0 ) BEGIN	//上刺刀按钮，还要复制CD两个物品改成上刺刀的枪械
					LPF ADD_ITEM_HEADER INT_VAR target = 5 speed = 3 drained = 0 STR_VAR icon = ~SYMBYNA~ name = ~@92~ RET new_header END
					LPF ADD_ITEM_EFFECT INT_VAR header = new_header type = 3 opcode = 112 target = 1 STR_VAR resource = ~SYM%guncode%~ END
					//LPF ADD_ITEM_EFFECT INT_VAR header = new_header type = 3 opcode = 111 target = 1 timing = 0 duration = 0 STR_VAR resource = ~MELFMET~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = new_header type = 3 opcode = 122 target = 1 timing = 1 STR_VAR resource = ~SYM%guncode%C~ END								
					LPF ADD_ITEM_HEADER INT_VAR target = 5 speed = 3 drained = 0 STR_VAR icon = ~SYMBYNB~ name = ~@93~ RET new_header END
					LPF ADD_ITEM_EFFECT INT_VAR header = new_header type = 3 opcode = 112 target = 1 STR_VAR resource = ~SYM%guncode%~ END
					//LPF ADD_ITEM_EFFECT INT_VAR header = new_header type = 3 opcode = 111 target = 1 timing = 0 duration = 0 STR_VAR resource = ~MELFMET~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = new_header type = 3 opcode = 122 target = 1 timing = 1 STR_VAR resource = ~SYM%guncode%D~ END
				END
				
				PATCH_IF ( gunscope > 0 ) BEGIN	//瞄准镜按钮，SYMSCP图标
					PATCH_IF ( gunbayonet > 0 ) BEGIN	//有超过三个物品头部了，不能再写头部名
						LPF ADD_ITEM_HEADER INT_VAR target = 5 speed = 1 drained = 0 STR_VAR icon = ~SYMSCP~ RET new_header END
					END ELSE BEGIN
						LPF ADD_ITEM_HEADER INT_VAR target = 5 speed = 1 drained = 0 STR_VAR icon = ~SYMSCP~ name = ~@97~ RET new_header END
					END
					LPF ADD_ITEM_EFFECT INT_VAR header = new_header type = 3 opcode = 262 target = 1 timing = 0 duration = 6 parameter1 = 50 parameter2 = 1 END
					LPF ADD_ITEM_EFFECT INT_VAR header = new_header type = 3 opcode = 239 target = 1 timing = 0 duration = 6 parameter2 = 1 END
					LPF ADD_ITEM_EFFECT INT_VAR header = new_header type = 3 opcode = 167 target = 1 timing = 0 duration = 6 parameter1 = gunscope END
				END
				
				PATCH_IF ( gunopenlock = 1 ) BEGIN	//开锁按钮
					LPF ADD_ITEM_HEADER INT_VAR target = 1 speed = 2 drained = 0 STR_VAR icon = ~SPWI207B~ name = ~@98~ RET new_header END
					LPF ADD_ITEM_EFFECT INT_VAR header = new_header type = 3 opcode = 125 target = 2 END
					LPF ADD_ITEM_EFFECT INT_VAR header = new_header type = 3 opcode = 174 target = 1 STR_VAR resource = ~SYM%guncode%A~ END
				END
				
				PATCH_IF ( gunmelee = 1 ) BEGIN	//添加近战补偿，每轮看见敌人对自己施展SYMMELEA.spl
					LPF ADD_ITEM_EQEFFECT INT_VAR opcode = 232 target = 1 parameter2 = 1 timing = 2 STR_VAR resource = ~SYMMELEA~ END
				END
				
			BUT_ONLY
			
			ACTION_IF ( gunfail != 0 ) BEGIN EXTEND_BOTTOM ~SYMFAIL.bcs~ ~%MOD_FOLDER%/baf/SYMFAIL1.baf~ EVALUATE_BUFFER END
			ACTION_IF ( gunruin != 0 ) BEGIN EXTEND_BOTTOM ~SYMFAIL.bcs~ ~%MOD_FOLDER%/baf/SYMFAIL2.baf~ EVALUATE_BUFFER END
			
			//复制枪械成损坏的
			COPY_EXISTING ~SYM%guncode%.itm~ ~override/SYM%guncode%A.itm~				
				PATCH_IF ( gunfail != 0 ) BEGIN	//轻微损坏
					LPF DELETE_ITEM_EQEFFECT INT_VAR opcode_to_delete = "-1" END
					WRITE_SHORT 0x18 0x2c
					WRITE_SHORT 0x1c 0
					WRITE_LONG 0x22 0x2020
					WRITE_SHORT 0x26 0
					SAY NAME2 ( AT "%gundesc2%" )
					SAY IDENTIFIED_DESC @81	//这支枪械出现了卡弹之类的小故障，你可以自己动手立刻解决问题。
					LPF DELETE_ITEM_HEADER INT_VAR header_type = ~-1~ END
					LPF ADD_ITEM_HEADER INT_VAR new_header_type = 3 location = 3 target = 5 speed = 9 charges = 1 drained = 1 STR_VAR icon = ~SYMRPR~ name = ~@91~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = 1 type = 3 opcode = 112 target = 1 STR_VAR resource = ~SYM%guncode%A~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = 1 type = 3 opcode = 122 target = 1 timing = 1 STR_VAR resource = ~SYM%guncode%~ END
				END
			BUT_ONLY
			COPY_EXISTING ~SYM%guncode%.itm~ ~override/SYM%guncode%B.itm~				
				PATCH_IF ( gunruin != 0 ) BEGIN	//严重损坏
					LPF DELETE_ITEM_EQEFFECT INT_VAR opcode_to_delete = "-1" END
					WRITE_SHORT 0x1c 0
					WRITE_LONG 0x1e 0xffff
					WRITE_LONG 0x20 0xffff
					WRITE_LONG 0x22 0x2020
					WRITE_SHORT 0x26 0
					SAY NAME2 ( AT "%gundesc3%" )
					SAY IDENTIFIED_DESC @82	//这支枪械出现了严重故障，你没法自行排除，只能把它送到枪店老板里那里，希望还没过保修期。
					LPF DELETE_ITEM_HEADER INT_VAR header_type = ~-1~ END
				END
			BUT_ONLY

			//复制枪械成长矛
			COPY_EXISTING ~SYM%guncode%.itm~ ~override/SYM%guncode%C.itm~				
				PATCH_IF ( gunbayonet != 0 ) & ( gunbayonet < 10 ) BEGIN	//上普通刺刀
					LPF DELETE_ITEM_EQEFFECT INT_VAR opcode_to_delete = "-1" END
					WRITE_SHORT 0x18 0x2e
					WRITE_SHORT 0x1c 29
					WRITE_LONG 0x22 0x5053
					WRITE_SHORT 0x26 5
					WRITE_SHORT 0x31 98
					WRITE_SHORT 0x60 0
					SAY NAME2  ( AT "%gundesc4%" )
					SAY IDENTIFIED_DESC ( AT "%gundesc6%" )
					LPF DELETE_ITEM_HEADER INT_VAR header_type = ~-1~ END
					LPF ADD_ITEM_HEADER INT_VAR new_header_type = 1 location = 1 target = 1 range = gunbayonet speed = 2 dicesize = 4 dicenumber = 2 damage_type = 6 animation_backhand = 20 animation_thrust = 80 flag_strength = 1 STR_VAR icon = ~SYMBYNC~ END
					LPF ADD_ITEM_HEADER INT_VAR target = 5 range = 1 speed = 3 STR_VAR icon = ~SYMBYNE~ name = ~@94~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 112 target = 1 STR_VAR resource = ~SYM%guncode%C~ END
					//LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 111 target = 1 timing = 0 duration = 0 STR_VAR resource = ~MELFMET~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 122 target = 1 timing = 1 STR_VAR resource = ~SYM%guncode%~ END
				END
				PATCH_IF ( gunbayonet == 11 ) BEGIN	//G11刺刀
					LPF DELETE_ITEM_EQEFFECT INT_VAR opcode_to_delete = "-1" END
					WRITE_SHORT 0x18 0x2e
					WRITE_SHORT 0x1c 29
					WRITE_LONG 0x22 0x5053
					WRITE_SHORT 0x26 5
					WRITE_SHORT 0x31 98
					WRITE_SHORT 0x60 0
					SAY NAME2 ( AT "%gundesc4%" )
					SAY IDENTIFIED_DESC ( AT "%gundesc6%" )
					LPF DELETE_ITEM_HEADER INT_VAR header_type = ~-1~ END
					LPF ADD_ITEM_HEADER INT_VAR new_header_type = 1 location = 1 target = 1 range = 1 speed = 2 dicesize = 6 dicenumber = 1 damage_type = 6 animation_backhand = 20 animation_thrust = 80 flag_strength = 1 STR_VAR icon = ~SYMBYNC~ END
					LPF ADD_ITEM_HEADER INT_VAR target = 5 range = 1 speed = 3 STR_VAR icon = ~SYMBYNE~ name = ~@94~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 112 target = 1 STR_VAR resource = ~SYM%guncode%C~ END
					//LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 111 target = 1 timing = 0 duration = 0 STR_VAR resource = ~MELFMET~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 122 target = 1 timing = 1 STR_VAR resource = ~SYM%guncode%~ END
				END
				PATCH_IF ( gunbayonet == 12 ) BEGIN	//李-恩菲尔德刺刀
					LPF DELETE_ITEM_EQEFFECT INT_VAR opcode_to_delete = "-1" END
					WRITE_SHORT 0x18 0x2e
					WRITE_SHORT 0x1c 29
					WRITE_LONG 0x22 0x5053
					WRITE_SHORT 0x26 5
					WRITE_SHORT 0x31 98
					WRITE_SHORT 0x60 0
					SAY NAME2 ( AT "%gundesc4%" )
					SAY IDENTIFIED_DESC ( AT "%gundesc6%" )
					LPF DELETE_ITEM_HEADER INT_VAR header_type = ~-1~ END
					LPF ADD_ITEM_HEADER INT_VAR new_header_type = 1 location = 1 target = 1 range = 2 speed = 2 dicesize = 6 dicenumber = 1 damage_type = 6 animation_backhand = 20 animation_thrust = 80 flag_strength = 1 STR_VAR icon = ~SYMBYNC~ END
					LPF ADD_ITEM_HEADER INT_VAR target = 5 range = 1 speed = 3 STR_VAR icon = ~SYMBYNE~ name = ~@94~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 112 target = 1 STR_VAR resource = ~SYM%guncode%C~ END
					//LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 111 target = 1 timing = 0 duration = 0 STR_VAR resource = ~MELFMET~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 122 target = 1 timing = 1 STR_VAR resource = ~SYM%guncode%~ END
				END
			BUT_ONLY
			COPY_EXISTING ~SYM%guncode%.itm~ ~override/SYM%guncode%D.itm~
				PATCH_IF ( gunbayonet != 0 ) & ( gunbayonet < 10 ) BEGIN	//上+3刺刀
					LPF DELETE_ITEM_EQEFFECT INT_VAR opcode_to_delete = "-1" END
					WRITE_SHORT 0x18 0x6e
					WRITE_SHORT 0x1c 29
					WRITE_LONG 0x22 0x5053
					WRITE_SHORT 0x26 5
					WRITE_SHORT 0x31 98
					WRITE_SHORT 0x60 3
					SAY NAME2 ( AT "%gundesc5%" )
					SAY IDENTIFIED_DESC ( AT "%gundesc7%" )
					LPF DELETE_ITEM_HEADER INT_VAR header_type = ~-1~ END
					LPF ADD_ITEM_HEADER INT_VAR new_header_type = 1 location = 1 target = 1 range = gunbayonet speed = 2 dicesize = 4 dicenumber = 2 damage_type = 6 animation_backhand = 20 animation_thrust = 80 flag_strength = 1 STR_VAR icon = ~SYMBYND~ END
					LPF ADD_ITEM_HEADER INT_VAR target = 5 range = 1 speed = 3 STR_VAR icon = ~SYMBYNE~ name = ~@94~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 112 target = 1 STR_VAR resource = ~SYM%guncode%D~ END
					//LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 111 target = 1 timing = 0 duration = 0 STR_VAR resource = ~MELFMET~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 122 target = 1 timing = 1 STR_VAR resource = ~SYM%guncode%~ END
				END
				PATCH_IF ( gunbayonet == 11 ) BEGIN	//G11刺刀
					LPF DELETE_ITEM_EQEFFECT INT_VAR opcode_to_delete = "-1" END
					WRITE_SHORT 0x18 0x6e
					WRITE_SHORT 0x1c 29
					WRITE_LONG 0x22 0x5053
					WRITE_SHORT 0x26 5
					WRITE_SHORT 0x31 98
					WRITE_SHORT 0x60 3
					SAY NAME2 ( AT "%gundesc5%" )
					SAY IDENTIFIED_DESC ( AT "%gundesc7%" )
					LPF DELETE_ITEM_HEADER INT_VAR header_type = ~-1~ END
					LPF ADD_ITEM_HEADER INT_VAR new_header_type = 1 location = 1 target = 1 range = 1 speed = 2 dicesize = 6 dicenumber = 1 damage_type = 6 animation_backhand = 20 animation_thrust = 80 flag_strength = 1 STR_VAR icon = ~SYMBYND~ END
					LPF ADD_ITEM_HEADER INT_VAR target = 5 range = 1 speed = 3 STR_VAR icon = ~SYMBYNE~ name = ~@94~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 112 target = 1 STR_VAR resource = ~SYM%guncode%D~ END
					//LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 111 target = 1 timing = 0 duration = 0 STR_VAR resource = ~MELFMET~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 122 target = 1 timing = 1 STR_VAR resource = ~SYM%guncode%~ END
				END
				PATCH_IF ( gunbayonet == 12 ) BEGIN	//李-恩菲尔德刺刀
					LPF DELETE_ITEM_EQEFFECT INT_VAR opcode_to_delete = "-1" END
					WRITE_SHORT 0x18 0x6e
					WRITE_SHORT 0x1c 29
					WRITE_LONG 0x22 0x5053
					WRITE_SHORT 0x26 5
					WRITE_SHORT 0x31 98
					WRITE_SHORT 0x60 3
					SAY NAME2 ( AT "%gundesc5%" )
					SAY IDENTIFIED_DESC ( AT "%gundesc7%" )
					LPF DELETE_ITEM_HEADER INT_VAR header_type = ~-1~ END
					LPF ADD_ITEM_HEADER INT_VAR new_header_type = 1 location = 1 target = 1 range = 2 speed = 2 dicesize = 6 dicenumber = 1 damage_type = 6 animation_backhand = 20 animation_thrust = 80 flag_strength = 1 STR_VAR icon = ~SYMBYND~ END
					LPF ADD_ITEM_HEADER INT_VAR target = 5 range = 1 speed = 3 STR_VAR icon = ~SYMBYNE~ name = ~@94~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 112 target = 1 STR_VAR resource = ~SYM%guncode%D~ END
					//LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 111 target = 1 timing = 0 duration = 0 STR_VAR resource = ~MELFMET~ END
					LPF ADD_ITEM_EFFECT INT_VAR header = 2 type = 3 opcode = 122 target = 1 timing = 1 STR_VAR resource = ~SYM%guncode%~ END
				END
			BUT_ONLY

			//额外扫射法术，每种枪对应法术名不同，都是看不见的全向大范围
			//法术检查正常不可能有的标记（26 ENTANGLE/27 WEB + 29 FREEACTION）给出额外攻击
			//如自由行动+缠绕，吃伤害1；如自由行动+蛛网+缠绕，吃伤害12
//这里最后还是用了等级施法SP1-7，检查是不是正常施展
//不行的话完全可以改成以人物等级施展，问题不大
			ACTION_IF ( gunburstplushits > 0 ) && (NOT FILE_EXISTS_IN_GAME ~SYMAMB%gunburstplus%.spl~) BEGIN
				COPY ~%MOD_FOLDER%/spl/SYMAMB0.spl~ ~override/SYMAMB%gunburstplus%.spl~
					WRITE_SHORT   0x98 ~%SYMAMEX0%~
					LPF ALTER_SPELL_EFFECT INT_VAR match_opcode = 318 STR_VAR resource = ~SYMAMB%gunburstplus%~ END	//检测生物状态，决定额外攻击是否生效
					PATCH_IF gunburstplushits > 5 BEGIN SET timespan = 1 END ELSE BEGIN SET timespan = 2 END	//攻击间隔，子弹太多时减少
					//伤害1
					PATCH_IF gunburstplushits MODULO 2 BEGIN	//奇数，0-49%多1发
						LPF ADD_SPELL_EFFECT INT_VAR opcode = 146 target = 2 timing = 1 probability1 = 49 parameter1 = gunsinglehit parameter2 = 2 insert_point = 2 STR_VAR resource = ~SYMSP%gunammtype%~ END
					END
					FOR (bursthit = 0 ; bursthit < (gunburstplushits / 2) ; ++bursthit) BEGIN
						LPF ADD_SPELL_EFFECT INT_VAR opcode = 146 target = 2 timing = 6 duration = (bursthit * timespan) parameter1 = gunsinglehit parameter2 = 2 insert_point = 2 STR_VAR resource = ~SYMSP%gunammtype%~ END
					END
					//伤害2
					PATCH_IF gunburstplushits MODULO 2 BEGIN	//奇数，50-100%多1发
						LPF ADD_SPELL_EFFECT INT_VAR opcode = 146 target = 2 timing = 1 probability2 = 50 parameter1 = gunsinglehit parameter2 = 2 STR_VAR resource = ~SYMSP%gunammtype%~ END
					END
					FOR (bursthit = 0 ; bursthit < (gunburstplushits / 2) ; ++bursthit) BEGIN
						LPF ADD_SPELL_EFFECT INT_VAR opcode = 146 target = 2 timing = 6 duration = (bursthit * timespan + 1) parameter1 = gunsinglehit parameter2 = 2 STR_VAR resource = ~SYMSP%gunammtype%~ END
					END
				BUT_ONLY
			END
			
			//单发枪声，已经有11号和51号枪
			ACTION_IF (gunid > 11) && (gunid < 50) && (gunsinglehit > 0) BEGIN
				COPY_EXISTING ~SYMSNDA1.spl~ ~override~
				LPF ADD_SPELL_HEADER INT_VAR copy_header = 1 RET insert_point END
				LPF ALTER_SPELL_HEADER INT_VAR header = (insert_point + 1) min_level = gunid END
				LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 174 STR_VAR resource = ~SYM%guncode%A~ END
			END
			ACTION_IF (gunid > 51) && (gunsinglehit > 0) BEGIN
				COPY_EXISTING ~SYMSNDA2.spl~ ~override~
				LPF ADD_SPELL_HEADER INT_VAR copy_header = 1 RET insert_point END
				LPF ALTER_SPELL_HEADER INT_VAR header = (insert_point + 1) min_level = gunid END
				LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 174 STR_VAR resource = ~SYM%guncode%A~ END			
			END

			//枪械施展的实际效果

			//1abc/3abc/5abc
			//2abcd/4abcd/6abcd/7abcd
			//8b/9e

			//最终的过程：
			//G有，AM不挡，可以保留SYMAMMIZ
			//G8: SYMAMM8a-bLV，【AMacde都不挡8a挡8b，AMb挡8a不挡8b】改SYMAMMIZ
			//修改后：
			//AMa IM:SYMAMMi IM:SYMAMM1-7b-d[+8b]+9e
			//G2: SYMAMMi(IM:all) SYMAMM2a-cLV+2dLE+9eLU
			//IM:SYMAMMi IM:SYMAMM1-7b-d+8b+9e SYMAMM2a-cLV+2dLE+9eLU > SYMAMM2aLV
			//AMd IM:SYMAMMi IM:SYMAMM1-7a-c[+8b]+9e
			//G2: SYMAMMi(IM:all) SYMAMM2a-cLV+2dLE+9eLU
			//IM:SYMAMMi IM:SYMAMM1-7a-c+8b+9e SYMAMM2a-cLV+2dLE+9eLU > SYMAMM2dLE
			//AMe IM:SYMAMMi IM:SYMAMM1-7a-d[+8b]
			//G2: SYMAMMi(IM:all) SYMAMM9eLU
			//IM:SYMAMMi IM:SYMAMM1-7a-d[+8b] SYMAMM9eLU > SYMAMM9eLU
			//AMa IM:SYMAMMi IM:SYMAMM1-7b-d[+8b]+9e
			//G8: SYMAMMi(IM:all) SYMAMM8aLE+8bL1
			//IM:SYMAMMi IM:SYMAMM1-7b-d+8b+9e SYMAMM8aLE+8bL1 > SYMAMM8aLE
			//AMb IM:SYMAMMi IM:SYMAMM1-7a+1-7c-d[+8a]+9e
			//G8: SYMAMMi(IM:all) SYMAMM8aLE+8bL1
			//IM:SYMAMMi IM:SYMAMM1-7a+1-7c-d[+8a]+9e SYMAMM8aLE+8bL1 > SYMAMM8bL1
			//AMe IM:SYMAMMi IM:SYMAMM1-7a-d[+8b]
			//G8: SYMAMMi(IM:all) SYMAMM8aLE+8bL1
			//IM:SYMAMMi IM:SYMAMM1-7a-d[+8b] SYMAMM8aLE+8bL1 > SYMAMM8aLE
			/*
			子弹a 目标免疫SYMAMMI 目标免疫SYMAMM1-7b-d+8b+9e，自身也免疫SYMAMM1-7b-d+8b+9e【这里没有7d，导致装填子弹a时，以lv999施展了7d】
			子弹b 目标免疫SYMAMMI 目标免疫SYMAMM1-7a+1-7c-d+8a+9e
			子弹d 目标免疫SYMAMMI 目标免疫SYMAMM1-7a-c+8b+9e
			子弹e 目标免疫SYMAMMI 目标免疫SYMAMM1-7a-d+8b
			口径2无扫射枪械: 对自身以gunid等级施法SYMSNDA1和2（延迟1帧播放单发枪声） 对目标放SYMAMMI(免疫全部) 对目标放SYMAMM2a-c（以所需等级）+2d（999级）+9e（动能等级）
			其中法术1-7a-d和8b、9e会对自身播放枪焰动画，1-7b-d和8b会对自身移除SYMSNDA1和2令其不再播放单发枪声，播放自带枪声
			
			口径2无扫射枪械装原版弹丸：对自身以gunid等级施法SYMSNDA1和2（延迟1帧播放单发枪声）对目标放SYMAMMI(免疫全部) 对目标放SYMAMM2a-c（以所需等级）+2d（999级）+9e（动能等级）
			最终：目标受SYMAMMI(免疫全部)，不受任何后继影响
			自身：单发枪声未被屏蔽（SYMAMMI要添加移除自身单发枪声）然后SYMAMM2a-c（以所需等级）+2d（999级）+9e（动能等级）中所有对自身的效果都存在（SYMAMMI要对自身屏蔽这些法术）
			未显示枪弹不合（SYMAMMI要显示弹药错误，子弹添加的免疫SYMAMMI对自身也要加一份）
			
			口径2无扫射枪械装子弹a：目标免疫SYMAMMI 目标免疫SYMAMM1-7b-d+8b+9e 对目标放SYMAMMI(免疫全部)被挡 对目标放SYMAMM2a-c（以所需等级）+2d（999级）+9e（动能等级）
			最终：对目标放SYMAMM2a（以所需等级）
			自身：SYMAMMI未被挡，如果加了各种对自身屏蔽则会导致枪焰枪声失效（子弹添加的免疫SYMAMMI对自身也要加一份）
			结果出现提示，子弹a的目标免疫SYMAMM1-7b-d+8b+9e必须添加让自己免疫2d
			SYMAMM2a-c（以所需等级）+2d（999级）+9e（动能等级）中对自身的枪焰动画和声音都存在（子弹a的目标免疫SYMAMM1-7b-d+8b+9e必须添加让自己也免疫）
			
			口径2无扫射枪械装子弹b：目标免疫SYMAMMI 目标免疫SYMAMM1-7a+1-7c-d+8a+9e 对目标放SYMAMM2a-c（以所需等级）+2d（999级）+9e（动能等级） 最终结果：SYMAMM2b（以所需等级）
			问题：2d（999级）是对自身，结果出现提示，子弹a的目标免疫SYMAMM1-7b-d+8b+9e必须添加让自己免疫2d
			
			口径2无扫射枪械装子弹d：目标免疫SYMAMMI 目标免疫SYMAMM1-7a-c+8b+9e 对目标放SYMAMM2a-c（以所需等级）+2d（999级）+9e（动能等级） 最终结果：SYMAMM2d（999级）
			正确
			
			口径2无扫射枪械装子弹e：目标免疫SYMAMMI 目标免疫SYMAMM1-7a-d+8b 对目标放SYMAMM2a-c（以所需等级）+2d（999级）+9e（动能等级） 最终结果：SYMAMM9e（动能等级）
			问题：2d（999级）是对自身，结果出现提示，子弹a的目标免疫SYMAMM1-7b-d+8b+9e必须添加让自己免疫2d
			
			结论：口径1-7的枪械如果无a-d中某种火力，则需要添加让自己免疫该SYMAMM1-7a-d
			
			子弹的免疫，全部都必须让自身也免疫
			枪焰不对
			SP8伤害半挥砍半穿刺
			SP1-7伤害类型参数2改8388608
			口径5以72级施法5abc的枪，安装弹药a-d都显示了5d（999级）的提示，安装弹药d能打中且打中的法术不是5d
			
			口径5无扫射枪械装子弹b：弹免疫SYMAMMI 弹免疫SYMAMM1-7a+1-7c+2467d+8a+9e 枪放SYMAMM5a-c（所需等级）+5d（999级）+9e（动能等级） 最终结果：SYMAMM5b+5d（所需等级）
			要不弹IZ添加对135d的免疫，要不枪弹不符统一指向8a
			
			狙击榴：施展SYMIM8（防止近炸），以等级1施展SYMAMMI（防护AMM1-9A-E），以等级999施展SYMAMM8A（1级显错），以等级1施展SYMAMM8B（1级开枪999级显错）
			子弹：以等级1施展SYMAMMIZ（防护SYMAMMI，防护除1-9A之外的1-9A-E）
			弹匣：以等级2施展SYMAMMIZ（防护SYMAMMI，防护除1-9B之外的1-9A-E）
			弹鼓：以等级3施展SYMAMMIZ（防护SYMAMMI，防护除1-9C之外的1-9A-E）不用防8A
			弹带：以等级4施展SYMAMMIZ（防护SYMAMMI，防护除1-9D之外的1-9A-E）不用防8A
			达姆：以等级5施展SYMAMMIZ（防护SYMAMMI，防护除1-9E之外的1-9A-E）不用防8A
			
			大部分枪械：以等级1施展SYMAMMI（防护AMM1-9A-E），以动能等级施展9E
			子弹：以等级1施展SYMAMMIZ（防护SYMAMMI，防护除1-9A之外的1-9A-D和9E）
			弹匣：以等级2施展SYMAMMIZ（防护SYMAMMI，防护除1-9B之外的1-9A-D和9E）
			弹鼓：以等级3施展SYMAMMIZ（防护SYMAMMI，防护除1-9C之外的1-9A-D和9E）
			弹带：以等级4施展SYMAMMIZ（防护SYMAMMI，防护除1-9D之外的1-9A-D和9E）
			达姆：以等级5施展SYMAMMIZ（防护SYMAMMI，防护1-9A-D）
			*/
			
			//所有可单发枪械开枪时以不同等级施法SYMSNDA1和2，内容为延迟1帧对自己播放单发枪声
			//如果连发成功施展则（amm1-7b-d）移除法术效果再播放正常枪声，如果弹药不对也移除法术效果（999级的amm1-9a-e）
			//SYMAMM1-7a不需要播放枪焰和声音，由枪自身调用SYMSNDA1和2释放。SYMAMM1-7b-d需要播放枪焰和声音，并且移除SYMSNDA1和2
			//保底法术：一个1级头部，有投射，有开火动画和声音（声音留空待改，1-8a没有声音），有最低等级调用SYMSP1-8，b-d还有移除SYMSNDA1和2
			//另外还要一个999级头部显示文字提示，8a8b9e前面加了，1-7a-d后面加
			//abcde必须是单体投射或无投射，调用fg可以使用群体投射
			ACTION_IF gunammtype < 8 BEGIN	//这里不需要8-9a-d，8a8b单独做8c8d没有，9a-d没有
				COPY_EXISTING ~SYMAMM%gunammtype%A.spl~ ~override~	//处理单发，已经写好1a的第一个法术头部（包括枪焰和1个调用SYMSP1，不放声音）
					PATCH_IF ( gunid == gunsinglehit ) & ( gunid != 81 ) BEGIN//不得超过40个头部所以缩编gunid成gunsinglehit，多余的gunid忽略，SYMAMM1-7a被以gunsinglehit等级施展再以gunsinglehit等级调用sp1-7
						LPF ADD_SPELL_HEADER INT_VAR copy_header = 1 RET insert_point END
						LPF ALTER_SPELL_HEADER INT_VAR header = (insert_point + 1) min_level = gunid END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 146 parameter1 = gunid STR_VAR resource = ~SYMSP%gunammtype%~ END
						PATCH_IF ( gunid = 61 ) BEGIN	//叮~
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 174 target = 1 timing = 0 duration = 1 probability1 = 61 probability2 = 50 STR_VAR resource = ~SYM%guncode%Z~ END
						END
						//提升自动武器经验，单发只有50%概率
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 309 target = 9 probability1 = 49 parameter1 = 1 parameter2 = 1 timing = 1 STR_VAR resource = ~SYMPRFA~ END
					END
					PATCH_IF ( gunid == 81 ) BEGIN	//81号短霰弹特殊投射，对每个敌人打2-4发钢珠，对大体型多造成一些伤害
						//枪声特殊，要移除单发枪声播放自己的
						LPF ADD_SPELL_HEADER INT_VAR copy_header = 1 RET insert_point END
						LPF ALTER_SPELL_HEADER INT_VAR header = (insert_point + 1) min_level = gunid projectile = SYMAMM2 END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 321 target = 9 timing = 1 STR_VAR resource = ~SYMSNDA2~ END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 321 target = 9 timing = 1 STR_VAR resource = ~SYMSNDA1~ END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 174 STR_VAR resource = ~SYM%guncode%A~ END
						//以保底等级调用1-2发SP2，再造成1-2次伤害，这样SP2的保底效果就不需要被设置成极弱
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 146 parameter1 = gunid STR_VAR resource = ~SYMSP2~ END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 parameter1 = gunid parameter2 = 2 probability1 = 24 STR_VAR resource = ~SYMSP2~ END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 12 target = 2 timing = 1 parameter2 = 8388608 dicenumber = 1 dicesize = 3 END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 12 target = 2 timing = 1 parameter2 = 8388608 dicenumber = 1 dicesize = 3 probability1 = 74 END
						//非大体型生物，免疫接下来的伤害
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 318 target = 2 timing = 1 parameter2 = 13 STR_VAR resource = ~SYMAMM%gunammtype%A~ END
						//大体型生物额外伤害
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 12 target = 2 timing = 1 parameter2 = 8388608 dicenumber = 1 dicesize = 3 END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 12 target = 2 timing = 1 parameter2 = 8388608 dicenumber = 1 dicesize = 3 END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 12 target = 2 timing = 1 parameter2 = 8388608 dicenumber = 1 dicesize = 3 probability1 = 49 END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 12 target = 2 timing = 1 parameter2 = 8388608 dicenumber = 1 dicesize = 3 probability1 = 64 probability2 = 12 END
					END
				BUT_ONLY

				COPY_EXISTING ~SYMAMM%gunammtype%B.spl~ ~override~//短点射多发，已经写好1b的第一个法术头部（包括枪焰和空声音和1个调用SYMSP%gunammtype%和暂停）
				//SYMAMM1-7b被以gunid等级施展再以gunsinglehit等级调用sp1-7，修改枪声，修改暂停时间（SYMSP%gunammtype%不按gunid而是按gunsinglehit区分调用特效SYMSPA1之类的等级）
					PATCH_IF ( gunbursthits > 0 ) & ( gunbursthits < 6 ) BEGIN	//平均打中整数发，少量
						LPF ADD_SPELL_HEADER INT_VAR copy_header = 1 RET insert_point END
						LPF ALTER_SPELL_HEADER INT_VAR header = (insert_point + 1) min_level = gunid END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 174 STR_VAR resource = ~SYM%guncode%B~ END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 165 duration = gunshortframe END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 146 parameter1 = gunsinglehit STR_VAR resource = ~SYMSP%gunammtype%~ END
						FOR (bursthit = 1 ; bursthit < gunbursthits ; ++bursthit) BEGIN
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 6 duration = bursthit parameter1 = gunsinglehit parameter2 = 2 STR_VAR resource = ~SYMSP%gunammtype%~ END
						END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 parameter1 = gunsinglehit parameter2 = 2 probability1 = 74 STR_VAR resource = ~SYMSP%gunammtype%~ END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 6 duration = 4 parameter1 = gunsinglehit parameter2 = 2 probability1 = 24 STR_VAR resource = ~SYMSP%gunammtype%~ END
					END
					PATCH_IF ( gunbursthits > 5 ) & ( gunbursthits < 11 ) BEGIN	//平均打中整数发，数量多
						LPF ADD_SPELL_HEADER INT_VAR copy_header = 1 RET insert_point END
						LPF ALTER_SPELL_HEADER INT_VAR header = (insert_point + 1) min_level = gunid END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 174 STR_VAR resource = ~SYM%guncode%B~ END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 165 duration = gunshortframe END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 146 parameter1 = gunsinglehit STR_VAR resource = ~SYMSP%gunammtype%~ END
						FOR (bursthit = 1 ; bursthit < 5 ; ++bursthit) BEGIN
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 6 duration = bursthit parameter1 = gunsinglehit parameter2 = 2 STR_VAR resource = ~SYMSP%gunammtype%~ END
						END
						FOR (bursthit = 5 ; bursthit < gunbursthits ; ++bursthit) BEGIN
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 6 duration = (bursthit - 5) parameter1 = gunsinglehit parameter2 = 2 STR_VAR resource = ~SYMSP%gunammtype%~ END
						END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 parameter1 = gunsinglehit parameter2 = 2 probability1 = 74 STR_VAR resource = ~SYMSP%gunammtype%~ END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 6 duration = 4 parameter1 = gunsinglehit parameter2 = 2 probability1 = 24 STR_VAR resource = ~SYMSP%gunammtype%~ END
					END
					PATCH_IF ( gunbursthits > 10 ) & ( gunbursthits < 21 ) BEGIN	//平均打中整数+0.5发
						LPF ADD_SPELL_HEADER INT_VAR copy_header = 1 RET insert_point END
						LPF ALTER_SPELL_HEADER INT_VAR header = (insert_point + 1) min_level = gunid END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 174 STR_VAR resource = ~SYM%guncode%B~ END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 165 duration = gunshortframe END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 146 parameter1 = gunsinglehit STR_VAR resource = ~SYMSP%gunammtype%~ END
						FOR (bursthit = 1 ; bursthit < ( gunbursthits - 10 ) ; ++bursthit) BEGIN
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 6 duration = (bursthit - 1) parameter1 = gunsinglehit parameter2 = 2 STR_VAR resource = ~SYMSP%gunammtype%~ END
						END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 6 duration = 4 parameter1 = gunsinglehit parameter2 = 2 probability1 = 49 STR_VAR resource = ~SYMSP%gunammtype%~ END
					END
					PATCH_IF ( gunbursthits > 20 ) & ( gunbursthits < 31 ) BEGIN	//固定打中整数发
						LPF ADD_SPELL_HEADER INT_VAR copy_header = 1 RET insert_point END
						LPF ALTER_SPELL_HEADER INT_VAR header = (insert_point + 1) min_level = gunid END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 174 STR_VAR resource = ~SYM%guncode%B~ END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 165 duration = gunshortframe END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 146 parameter1 = gunsinglehit STR_VAR resource = ~SYMSP%gunammtype%~ END
						FOR (bursthit = 1 ; bursthit < ( gunbursthits - 20 ) ; ++bursthit) BEGIN
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 parameter1 = gunsinglehit parameter2 = 2 STR_VAR resource = ~SYMSP%gunammtype%~ END
						END
					END
					//对大体型额外点射
					PATCH_IF ( gunhugeexhits > 0 ) & ( gunhugeexhits < 11 ) BEGIN
						FOR (hugeexhit = 1 ; hugeexhit < gunhugeexhits ; ++hugeexhit) BEGIN
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 6 duration = (hugeexhit - 1) parameter2 = 13 STR_VAR resource = ~SYMSP%gunammtype%~ END
						END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 6 duration = 4 parameter2 = 13 probability2 = 25 STR_VAR resource = ~SYMSP%gunammtype%~ END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 1 parameter2 = 13 probability2 = 75 STR_VAR resource = ~SYMSP%gunammtype%~ END
					END
					PATCH_IF ( gunhugeexhits > 10 ) & ( gunhugeexhits < 21 ) BEGIN
						FOR (hugeexhit = 0 ; hugeexhit < (gunhugeexhits - 10) ; ++hugeexhit) BEGIN
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 6 duration = (hugeexhit - 1) parameter2 = 13 STR_VAR resource = ~SYMSP%gunammtype%~ END
						END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 6 duration = 4 parameter2 = 13 probability2 = 50 STR_VAR resource = ~SYMSP%gunammtype%~ END
					END
					PATCH_IF gunbursthits > 0 BEGIN	//提升自动武器经验
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 309 target = 9 parameter1 = 1 parameter2 = 1 timing = 1 STR_VAR resource = ~SYMPRFA~ END
					END
				BUT_ONLY

				COPY_EXISTING ~SYMAMM%gunammtype%C.spl~ ~override~	//长点射启动准备，已写好第一个法术头部（包括枪焰和空声音和1个调用SYMAMM%gunammtype%E和移除单发枪声和暂停）
				//SYMAMM1-7c被以gunid等级施展再以gunid等级调用SYMAMM1-7e，修改枪声，修改暂停时间
					PATCH_IF ( gunlongframe != 0 ) BEGIN
						LPF ADD_SPELL_HEADER INT_VAR copy_header = 1 RET insert_point END
						LPF ALTER_SPELL_HEADER INT_VAR header = (insert_point + 1) min_level = gunid END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 174 STR_VAR resource = ~SYM%guncode%C~ END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 165 duration = gunlongframe END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 146 parameter1 = gunid STR_VAR resource = ~SYMAMM%gunammtype%E~ END
						//提升自动武器经验
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 309 target = 9 parameter1 = 2 parameter2 = 1 timing = 1 STR_VAR resource = ~SYMPRFA~ END
					END
				BUT_ONLY

				COPY_EXISTING ~SYMAMM%gunammtype%D.spl~ ~override~	//扫射启动准备，已写好第一个法术头部（包括枪焰和空声音和1个调用SYMAMM%gunammtype%F和移除单发枪声和暂停）
				//SYMAMM1-7d被以gunid等级施展再以gunid等级调用SYMAMM1-7f，修改枪声，修改暂停时间
					PATCH_IF ( gunstrafeframe != 0 ) BEGIN
						LPF ADD_SPELL_HEADER INT_VAR copy_header = 1 RET insert_point END
						LPF ALTER_SPELL_HEADER INT_VAR header = (insert_point + 1) min_level = gunid END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 174 STR_VAR resource = ~SYM%guncode%D~ END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 165 duration = gunstrafeframe END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 146 parameter1 = gunid STR_VAR resource = ~SYMAMM%gunammtype%F~ END
						//提升自动武器经验
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 309 target = 9 parameter1 = 2 parameter2 = 1 timing = 1 STR_VAR resource = ~SYMPRFA~ END
					END
				BUT_ONLY

				COPY_EXISTING ~SYMAMM%gunammtype%E.spl~ ~override~	//长点射概率AOE，已写好第一个法术头部（只有1个SYMSP%gunammtype%）
				//SYMAMM1-7e被以gunid等级施展再以gunsinglehit等级调用sp1-7，修改范围投射
					PATCH_IF ( gunlongframe != 0 ) BEGIN
						LPF ADD_SPELL_HEADER INT_VAR copy_header = 1 projectile = (gunrange < 30) ? SYMAMM3 : SYMAMM4 RET insert_point END
						LPF ALTER_SPELL_HEADER INT_VAR header = (insert_point + 1) min_level = gunid END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 146 parameter1 = gunsinglehit probability1 = (gunstrafetohit - 1) STR_VAR resource = ~SYMSP%gunammtype%~ END
					END
					//对大体型额外扫射
					PATCH_IF ( gunhugeextohit > 0 ) & ( gunhugeextohit < 101 ) BEGIN
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 1 parameter2 = 13 probability2 = (100 - gunhugeextohit) STR_VAR resource = ~SYMSP%gunammtype%~ END
					END
					PATCH_IF ( gunhugeextohit > 100 ) & ( gunhugeextohit < 201 ) BEGIN
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 1 parameter2 = 13 STR_VAR resource = ~SYMSP%gunammtype%~ END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 1 parameter2 = 13 probability2 = (200 - gunhugeextohit) STR_VAR resource = ~SYMSP%gunammtype%~ END
					END
				BUT_ONLY

				COPY_EXISTING ~SYMAMM%gunammtype%F.spl~ ~override~//扫射概率AOE，已写好第一个法术头部（只有1个SYMSP%gunammtype%）
				//SYMAMM1-7f被以gunid等级施展再以gunsinglehit等级调用sp1-7，修改范围投射
					PATCH_IF ( gunstrafeframe != 0 ) BEGIN
						LPF ADD_SPELL_HEADER INT_VAR copy_header = 1 projectile = (gunrange < 30) ? SYMAMM5 : SYMAMM6 RET insert_point END
						LPF ALTER_SPELL_HEADER INT_VAR header = (insert_point + 1) min_level = gunid END
						LPF ALTER_SPELL_EFFECT INT_VAR header = (insert_point + 1) match_opcode = 146 parameter1 = gunsinglehit probability1 = (gunstrafetohit - 1) STR_VAR resource = ~SYMSP%gunammtype%~ END
					END				
					//对大体型额外扫射
					PATCH_IF ( gunhugeextohit > 0 ) & ( gunhugeextohit < 101 ) BEGIN
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 1 parameter2 = 13 probability2 = (100 - gunhugeextohit) STR_VAR resource = ~SYMSP%gunammtype%~ END
					END
					PATCH_IF ( gunhugeextohit > 100 ) & ( gunhugeextohit < 201 ) BEGIN
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 1 parameter2 = 13 STR_VAR resource = ~SYMSP%gunammtype%~ END
						LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 1 parameter2 = 13 probability2 = (200 - gunhugeextohit) STR_VAR resource = ~SYMSP%gunammtype%~ END
					END
				BUT_ONLY
				//总结：枪械以缩编的gunsinglehit等级施展SYMAMM1-7a，以未缩编等级gunid施展SYMAMM1-7bcd
				//sp1-7仅有gunsinglehit等级，未缩编等级SYMAMM1-7bcd调用sp1-7需在内部进行缩编，即所需等级为gunid而调用sp1-7等级为gunsinglehit
				//SYMAMM1-7a被以gunsinglehit等级施展再以gunsinglehit等级调用sp1-7（不得超过40个头部所以缩编gunid成gunsinglehit，多余的gunid忽略）
				//SYMAMM1-7b被以gunid等级施展再以gunsinglehit等级调用sp1-7，修改枪声，（sp1-7不按gunid而是按gunsinglehit区分调用特效SYMSPA1之类的等级）
				//SYMAMM1-7c被以gunid等级施展再以gunid等级调用SYMAMM1-7e，修改枪声，修改暂停时间
				//SYMAMM1-7d被以gunid等级施展再以gunid等级调用SYMAMM1-7f，修改枪声，修改暂停时间
				//SYMAMM1-7e被以gunid等级施展再以gunsinglehit等级调用sp1-7，修改范围投射
				//SYMAMM1-7f被以gunid等级施展再以gunsinglehit等级调用sp1-7，修改范围投射


				//处理各类型的单发子弹效果SYMSP1-7，直接加头部而不是复制，需要输入投射，造成枪械表格等级对应伤害，并以枪械动能等级调用特效SPA-H1-3
				//有一个1级的保底效果受额外扫射调用，特效概率最低
				COPY_EXISTING ~SYMSP%gunammtype%.spl~ ~override~
					PATCH_IF ( gunid = gunsinglehit ) & ( gunid != 81 ) BEGIN	//仅有gunsinglehit等级
						PATCH_IF ( gunammtype = 1 ) BEGIN
							LPF ADD_SPELL_HEADER INT_VAR location = 0 range = 250 required_level = gunid projectile = SYMAMM1 RET insert_point END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 12 target = 2 timing = 1 parameter2 = 8388608 dicenumber = gundicethrown dicesize = gundicesides parameter1 = gundiceplus END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (15 * gunprobability / 100 - 1) parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPA1~ END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (25 * gunprobability / 100 + 14) probability2 = 15 parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPB1~ END
						END
						PATCH_IF ( gunammtype = 2 ) BEGIN
							LPF ADD_SPELL_HEADER INT_VAR location = 0 range = 250 required_level = gunid projectile = SYMAMM1 RET insert_point END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 12 target = 2 timing = 1 parameter2 = 8388608 dicenumber = gundicethrown dicesize = gundicesides parameter1 = gundiceplus END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (10 * gunprobability / 100 - 1) parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPA1~ END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (40 * gunprobability / 100 + 9) probability2 = 10 parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPB1~ END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (25 * gunprobability / 100 + 49) probability2 = 50 parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPD1~ END
						END
						PATCH_IF ( gunammtype = 3 ) BEGIN
							LPF ADD_SPELL_HEADER INT_VAR location = 0 range = 250 required_level = gunid projectile = SYMAMM1 RET insert_point END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 12 target = 2 timing = 1 parameter2 = 8388608 dicenumber = gundicethrown dicesize = gundicesides parameter1 = gundiceplus END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (10 * gunprobability / 100 - 1) parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPF1~ END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (60 * gunprobability / 100 + 9) probability2 = 10 parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPC1~ END
							//大体型额外吃保底的SYMSPC1，合计吃SYMSPC1达到最高概率
							PATCH_IF (60 * gunprobability / 100) < 60 BEGIN
								LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 1 probability1 = 69 probability2 = (60 * gunprobability / 100 + 10) parameter2 = 13 STR_VAR resource = ~SYMSPC1~ END
							END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (25 * gunprobability / 100 + 69) probability2 = 70 parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPG1~ END
						END
						PATCH_IF ( gunammtype = 4 ) BEGIN
							LPF ADD_SPELL_HEADER INT_VAR location = 0 range = 250 required_level = gunid projectile = SYMAMM1 RET insert_point END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 12 target = 2 timing = 1 parameter2 = 8388608 dicenumber = gundicethrown dicesize = gundicesides parameter1 = gundiceplus END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (30 * gunprobability / 100 - 1) parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPA2~ END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (20 * gunprobability / 100 + 29) probability2 = 30 parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPB2~ END
						END
						PATCH_IF ( gunammtype = 5 ) BEGIN
							LPF ADD_SPELL_HEADER INT_VAR location = 0 range = 250 required_level = gunid projectile = SYMAMM1 RET insert_point END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 12 target = 2 timing = 1 parameter2 = 8388608 dicenumber = gundicethrown dicesize = gundicesides parameter1 = gundiceplus END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (25 * gunprobability / 100 - 1) parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPA2~ END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (25 * gunprobability / 100 + 24) probability2 = 20 parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPH2~ END
							//大体型额外吃保底的SYMSPH2，合计吃SYMSPH2达到最高概率
							PATCH_IF (25 * gunprobability / 100) < 25 BEGIN
								LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 1 probability1 = 49 probability2 = (25 * gunprobability / 100 + 25) parameter2 = 13 STR_VAR resource = ~SYMSPH2~ END
							END
						END
						PATCH_IF ( gunammtype = 6 ) BEGIN
							LPF ADD_SPELL_HEADER INT_VAR location = 0 range = 250 required_level = gunid projectile = SYMAMM1 RET insert_point END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 12 target = 2 timing = 1 parameter2 = 8388608 dicenumber = gundicethrown dicesize = gundicesides parameter1 = gundiceplus END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (45 * gunprobability / 100 - 1) parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPA2~ END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (25 * gunprobability / 100 + 39) probability2 = 45 parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPC2~ END
							//大体型额外吃保底的SYMSPC2，合计吃SYMSPC2达到最高概率
							PATCH_IF (25 * gunprobability / 100) < 25 BEGIN
								LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 1 probability1 = 64  probability2 = (25 * gunprobability / 100 + 40) parameter2 = 13 STR_VAR resource = ~SYMSPC2~ END
							END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (35 * gunprobability / 100 + 64) probability2 = 65 parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPE2~ END
							//大体型额外吃保底的SYMSPE2，合计吃SYMSPE2达到最高概率
							PATCH_IF (35 * gunprobability / 100) < 35 BEGIN
								LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 1 probability1 = 99 probability2 = (35 * gunprobability / 100 + 65) parameter2 = 13 STR_VAR resource = ~SYMSPE2~ END
							END
						END
						PATCH_IF ( gunammtype = 7 ) BEGIN
							LPF ADD_SPELL_HEADER INT_VAR location = 0 range = 250 required_level = gunid projectile = SYMAMM1 RET insert_point END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 12 target = 2 timing = 1 parameter2 = 8388608 dicenumber = gundicethrown dicesize = gundicesides parameter1 = gundiceplus END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (60 * gunprobability / 100 - 1) parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPA3~ END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (10 * gunprobability / 100 + 59) probability2 = 60 parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPC3~ END
							//大体型额外吃保底的SYMSPC3，合计吃SYMSPC3达到最高概率
							PATCH_IF (10 * gunprobability / 100) < 10 BEGIN
								LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 1 probability1 = 69 probability2 = (10 * gunprobability / 100 + 60) parameter2 = 13 STR_VAR resource = ~SYMSPC3~ END
							END
							LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 146 target = 2 timing = 1 probability1 = (30 * gunprobability / 100 + 69) probability2 = 70 parameter1 = gunkinetic parameter2 = 2 STR_VAR resource = ~SYMSPE3~ END
							//大体型额外吃保底的SYMSPE3，合计吃SYMSPE3达到最高概率
							PATCH_IF (30 * gunprobability / 100) < 30 BEGIN
								LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 326 target = 2 timing = 1 probability1 = 99 probability2 = (30 * gunprobability / 100 + 70) parameter2 = 13 STR_VAR resource = ~SYMSPE3~ END
							END
						END
					END
					//gunammtype = 8是SYMSP8狙击榴，不在这处理
					//gunammtype = 9是SYMSP9达姆弹，不需要了，直接用SYMAMM9e

				BUT_ONLY
			END
		END
	END
BUT_ONLY

EXTEND_BOTTOM ~SYMFAIL.bcs~ ~%MOD_FOLDER%/baf/SYMFAIL3.baf~

/*****************最后加上显示枪弹不符的999级提示*******************/
//8a只有显示提示的效果，8b和9e要加999级提示，这些前面已经加过了
//顺便加上召唤鸟的法术
ACTION_FOR_EACH gunammtype IN 1 2 3 4 5 6 7 BEGIN
	ACTION_FOR_EACH ammcode IN a b c d BEGIN
		COPY_EXISTING ~SYMAMM%gunammtype%%ammcode%.spl~ ~override~
			LPF ADD_SPELL_EFFECT INT_VAR opcode = 146 target = 9 timing = 1 parameter2 = 1 STR_VAR resource = ~SYMFAIL~ END
			LPF ADD_SPELL_HEADER INT_VAR type = 2 location = 0 range = 250 required_level = 999 projectile = SYMAMM0 RET insert_point END
			LPF ADD_SPELL_EFFECT INT_VAR header = (insert_point + 1) opcode = 139 target = 9 timing = 1 parameter1 = RESOLVE_STR_REF(@80) END
	END
END

/*****************针对轻甲，穿甲类枪械的部分特效需要被屏蔽*******************/
COPY_EXISTING ~SYMSP3.spl~ ~override~
	LPF ADD_SPELL_EFFECT INT_VAR insert_point = 1 opcode = 146 target = 2 timing = 10 duration = 5 parameter1 = 1 parameter2 = 2 STR_VAR resource = ~SYMIMC1~ END
COPY_EXISTING ~SYMSP5.spl~ ~override~
	LPF ADD_SPELL_EFFECT INT_VAR insert_point = 1 opcode = 146 target = 2 timing = 10 duration = 5 parameter1 = 1 parameter2 = 2 STR_VAR resource = ~SYMIMH2~ END
COPY_EXISTING ~SYMSP6.spl~ ~override~
	LPF ADD_SPELL_EFFECT INT_VAR insert_point = 1 opcode = 146 target = 2 timing = 10 duration = 5 parameter1 = 1 parameter2 = 2 STR_VAR resource = ~SYMIMC2~ END
	LPF ADD_SPELL_EFFECT INT_VAR insert_point = 2 opcode = 146 target = 2 timing = 10 duration = 5 parameter1 = 1 parameter2 = 2 STR_VAR resource = ~SYMIME2~ END
COPY_EXISTING ~SYMSP7.spl~ ~override~
	LPF ADD_SPELL_EFFECT INT_VAR insert_point = 1 opcode = 146 target = 2 timing = 10 duration = 5 parameter1 = 1 parameter2 = 2 STR_VAR resource = ~SYMIMC3~ END
	LPF ADD_SPELL_EFFECT INT_VAR insert_point = 2 opcode = 146 target = 2 timing = 10 duration = 5 parameter1 = 1 parameter2 = 2 STR_VAR resource = ~SYMIME3~ END


/****************游戏中原有铠甲批处理*******************/

//产生marmors和harmors数组，下标为铠甲名，值为1
COPY_EXISTING_REGEXP GLOB ~.*\.itm~ ~override~
	PATCH_IF (SOURCE_SIZE > 0x71) BEGIN
		READ_SHORT 0x1c type //物品类型，甲是2
		READ_LONG 0x22 icon //穿上后外表变化，锁子甲3a，铠甲4a
			PATCH_IF (type=0x02) AND (icon=0x4133) BEGIN
				SET $marmors(~%SOURCE_RES%~)=1
			END
			PATCH_IF (type=0x02) AND (icon=0x4134) BEGIN
				SET $harmors(~%SOURCE_RES%~)=1
			END
	END
BUT_ONLY

//产生effmarmor和effharmor数组，下标为需要免疫的法术名，值为序号
ACTION_DEFINE_ASSOCIATIVE_ARRAY effmarmor BEGIN	//中甲需要添加免疫的法术
	SYMSPD1 => 1 SYMIMC1 => 2 SYMSPG1 => 3
	SYMIMH2 => 4 SYMIMC2 => 5
	SYMIMC3 => 6 
END

ACTION_DEFINE_ASSOCIATIVE_ARRAY effharmor BEGIN	//重甲需要添加免疫的法术
	SYMSPB1 => 1 SYMSPD1 => 2 SYMSPF1 => 3
	SYMSPB2 => 4 SYMIMH2 => 5 SYMIME2 => 6
	SYMIME3 => 7
END

//对marmors和harmors数组中每个铠甲，批量添加免疫法术
ACTION_PHP_EACH marmors AS marmor => int BEGIN
	COPY_EXISTING ~%marmor%.itm~ ~override~
		PHP_EACH effmarmor AS marmo => int BEGIN
			LPF ADD_ITEM_EQEFFECT INT_VAR opcode=206 target=1 timing=2 STR_VAR resource=EVAL ~%marmo%~ END
		END
	BUT_ONLY
END

ACTION_PHP_EACH harmors AS harmor => int BEGIN
	COPY_EXISTING ~%harmor%.itm~ ~override~
		PHP_EACH effharmor AS harmo => int BEGIN
			LPF ADD_ITEM_EQEFFECT INT_VAR opcode=206 target=1 timing=2 STR_VAR resource=EVAL ~%harmo%~ END
		END
	BUT_ONLY
END

//批量修改法术实现特定生物对其免疫
ACTION_PHP_EACH effmarmor AS marmo => int BEGIN
	COPY_EXISTING ~%marmo%.spl~ ~override~
		PATCH_FOR_EACH shellrace IN 101 130 160 167 BEGIN	//掘地虫、土巨怪、犀甲虫、恐爪怪视为中甲
			LPF ADD_SPELL_EFFECT INT_VAR insert_point = 0 opcode = 318 target = 2 parameter1 = shellrace parameter2 = 104 STR_VAR resource = ~%marmo%~ END
		END
	BUT_ONLY
END

ACTION_PHP_EACH effharmor AS harmor => int BEGIN
	COPY_EXISTING ~%marmo%.spl~ ~override~
		PATCH_FOR_EACH shellrace IN 144 146 BEGIN	//魔像、龙视为重甲
			LPF ADD_SPELL_EFFECT INT_VAR insert_point = 0 opcode = 318 target = 2 parameter1 = shellrace parameter2 = 104 STR_VAR resource = ~%marmo%~ END
		END
	BUT_ONLY
END


