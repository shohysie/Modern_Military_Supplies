//拿走后摧毁，保证只剩一个
IF
	HasItem("SYMUAV1",Myself)
THEN
	RESPONSE #100
		DestroyItem("SYMUAV1")
		Continue()
END
//拿走后产生一个坏的用来丢地上
IF
	Global("moveitem","LOCALS",1)
THEN
	RESPONSE #100
		CreateItem("SYMUAV1A",0,0,0)
		SetGlobal("moveitem","LOCALS",2)
		Continue()
END

//关机回收
IF
	OR(2)
		GlobalTimerExpired("Existime","LOCALS")
		Global("SHUTDOWN","LOCALS",1)
	Range([PC],4)
THEN
	RESPONSE #100
		GiveItemCreate("SYMUAV1",[PC],0,0,0)
		DestroySelf()
END
//关机时视野内有玩家，正常返回最近的玩家
IF
	OR(2)
		GlobalTimerExpired("Existime","LOCALS")
		Global("SHUTDOWN","LOCALS",1)
	Detect([PC])
	!Range([PC],4)
	!TargetUnreachable([PC])
THEN
	RESPONSE #100
		DisplayStringHead(Myself,@150)	//返回中……
		MoveToObjectNoInterrupt([PC])
END
//关机时正常返回视野外玩家，按Player顺序
IF
	OR(2)
		GlobalTimerExpired("Existime","LOCALS")
		Global("SHUTDOWN","LOCALS",1)
	InMyArea(Player1)
	!TargetUnreachable(Player1)
	!Detect([PC])
THEN
	RESPONSE #100
		DisplayStringHead(Myself,@150)	//返回中……
		MoveToObjectNoInterrupt(Player1)
END

